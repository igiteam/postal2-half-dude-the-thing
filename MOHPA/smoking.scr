// --------------------------------------------------------------------------------
// Smoking.scr
//
// This is a sub script that can be called as a subroutine
// whenever an animation behavior wants to smoke

// --------------------------------------------------------------------------------


// --------------------------------------------------------------------------------
Smoke:
//
//	Will play our various smoking animations until it's time to throw it out...
//
// --------------------------------------------------------------------------------

	// make sure we're standing up when we start smoking
	self waitthread anim/stand.scr::transition

	if ( self.smoking_starttime==NIL )
		self.smoking_starttime = 0

	if ( self.smoking_starttime==0 )
	{
		self waitthread LightUp
	}

	self waitthread SmokingLoop

	end


// --------------------------------------------------------------------------------
LightUp:
// --------------------------------------------------------------------------------
	self setmotionanim xxxxx_smoking_light
	self waittill flaggedanimdone

//	dprintln "Lighting up a cig!"

	if ( self.smoking_mintime==NIL )
		self.smoking_mintime = 30

	if ( self.smoking_maxtime==NIL )
		self.smoking_maxtime  = 60

	self.smoking_starttime			= level.time
	self.smoking_endtime			= level.time + self.smoking_mintime + randomfloat (self.smoking_maxtime - self.smoking_mintime)
//	self.smoking_endtime			= level.time + 10
	self.idletaskexitthread			= "anim/smoking.scr::SmokingInterrupt"

	end

// --------------------------------------------------------------------------------
SmokingLoop:
// --------------------------------------------------------------------------------

	local.took_hit = 0

	self setmotionanim xxxxx_smoking_inhale
	self waittill flaggedanimdone

	local.took_hit = 2


	while ( isAlive self && level.time < self.smoking_endtime )
	{
		local.random = randomint 100

		if ( local.took_hit==0 && local.random < 30 )
		{
			self setmotionanim xxxxx_smoking_inhale
			self waittill flaggedanimdone

			// flag so we don't do 2 inhales in a row...
			local.took_hit = 3
		}
		else
		{
			self setmotionanim xxxxx_smoking_idle
			self waittill flaggedanimdone

			if ( local.took_hit > 0 )
				local.took_hit --
		}
	}

	if ( isAlive self )
	{
//		dprintln "Time to stop smoking."
		// all done with this smoke...
		self setmotionanim xxxex_smoking_throwaway
		self waittill flaggedanimdone

//		dprintln "Threw cigarette away!."

	}

	self.smoking_starttime = 0

	end

// --------------------------------------------------------------------------------
SmokingInterrupt:
//
//	Will play animation to get rid of my cigarette and start fighting...
//
// --------------------------------------------------------------------------------

//	dprintln "smoking interrupt!!"

	self setmotionanim xxxcx_smoking_throwaway
	self waittill flaggedanimdone
	self.smoking_starttime = 0

	end

// --------------------------------------------------------------------------------
// --------------------------------------------------------------------------------

// --------------------------------------------------------------------------------
SmokeRemoveCigarette:
RemoveCigarette:
// --------------------------------------------------------------------------------

	end

// --------------------------------------------------------------------------------
StartSmoking local.howlongmin local.howlongmax:
//
//	This function can be called from outside scripts. 
//	Will auto-launch and idle task that will do the smoking bit...
// --------------------------------------------------------------------------------

	// jsl-->Mohpa kicked the habit on 09/23/2004  (for ERSB reasons)
	end

	self.smoking_mintime	= local.howlongmin
	self.smoking_maxtime	= local.howlongmax


	self.idletaskthread		= "anim/smoking.scr::Smoke"

	self waittill taskdone

	end


