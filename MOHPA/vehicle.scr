// ON
on_raftlcrs_driver:

	if ( (self.raftanim != NIL) && (self.raftanim != "") )
	{
		self setmotionanim self.raftanim
		self waittill flaggedanimdone
		self animevent
	}
	else
	{
		self setmotionanim xvxxx_raftlcrs_idle_driver
		self waittill flaggedanimdone
	}

end

on_raftlcrs_passenger_1:

	if ( (self.raftanim != NIL) && (self.raftanim != "") )
	{
		self setmotionanim self.raftanim
