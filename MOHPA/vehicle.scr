//============================================================================
// Scout - front passenger (left side)
//============================================================================
enter_scout_passenger:

	self setmotionanim xvxxp_scout_mount
	self waittill flaggedanimdone

end

exit_scout_passenger:

	self setmotionanim xvxxp_scout_dismount
	self waittill flaggedanimdone

end

on_scout_passenger:

	self aimanimationlimits 37.5 82.5 82.5

	while ( 1 )
	{
		switch ( self.mood )
		{
		case alert:
			self setmotionanim xvxxp_js_intense_idle
			self waittill flaggedanimdone
			break
		default:
			self setmotionanim xvxxp_js_idle
			self waittill flaggedanimdone
			break
		}
	}

end

on_scout_passenger_idletoaim:

	self setmotionanim xvxxp_scout_shootintro
	self waittill flaggedanimdone

end

on_scout_passenger_aimtoidle:

	self setmotionanim xvxxp_scout_shootoutro
	self waittill flaggedanimdone

end

on_scout_passenger_aim:

	while ( 1 )
	{
		self setmotionanim xvxxp_scout_aim
		self waittill flaggedanimdone
	}

end

on_scout_passenger_shoot:

	while ( 1 )
	{
		self setmotionanim xvxxp_scout_shoot
		self waittill flaggedanimdone
	}

end

on_scout_passenger_reload:

	self setmotionanim xvxxp_scout_shootoutro
	self waittill flaggedanimdone

	self setmotionanim xvxxp_js_reload
	self waittill flaggedanimdone

	self setmotionanim xvxxp_scout_shootintro
	self waittill flaggedanimdone

end

on_scout_passenger_hit:

	self setmotionanim xvxxp_js_hit
	self waittill flaggedanimdone

end

on_scout_passenger_hitaim:

	self setmotionanim xvxxp_scout_hit_shoot
	self waittill flaggedanimdone

end


