//--------------------------------------------------------------------------------

enter_jeep_driver:

	self setmotionanim xuxxx_jeep_driver_mount
	self waittill flaggedanimdone

end

exit_jeep_driver:

	self setmotionanim xuxxx_jeep_driver_dismount
	self waittill flaggedanimdone

end

enter_jeep_passenger:

	self setmotionanim xvxxp_js_mount	
	self waittill flaggedanimdone

end

exit_jeep_passenger:

	self setmotionanim xvxxp_js_dismount
	self waittill flaggedanimdone

end

enter_jeep_turret:

	self setmotionanim xuxxx_jeep_gun_mount
	self waittill flaggedanimdone

end

exit_jeep_turret:

	self setmotionanim xuxxx_jeep_gun_dismount
	self waittill flaggedanimdone

end

on_jeep_driver:

	switch ( self.mood )
	{
	case alert:
		self setmotionanim xvxxd_js_idle_intense
		self waittill flaggedanimdone
		break
	case atease:
		self setmotionanim xvxxd_js_idle_casual
		self waittill flaggedanimdone
		break
	default:
		self setmotionanim xvxxd_js_idle
		self waittill flaggedanimdone
		break
	}
end

on_jeep_passenger:


	switch ( self.mood )
	{
	case alert:
		self setmotionanim xvxxp_js_intense_idle
		self waittill flaggedanimdone
		break
	case atease:
		self setmotionanim xvxxp_js_casual_idle
		self waittill flaggedanimdone
		break
	default:
		self setmotionanim xvxxp_js_idle
		self waittill flaggedanimdone
		break
	}

end

on_jeep_turret:

	self setmotionanim xuxxx_jeep_driving_idle
	self waittill flaggedanimdone

end


