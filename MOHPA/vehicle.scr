main:
end

//--------------------------------------------------------------------------------
// default animation if specific thread doesn't exist
//--------------------------------------------------------------------------------
noanim:

	//dprintln "********** ERROR in vehicle.scr: thinker specified non-existent thread."
	self setmotionanim xvxxd_js_idle
	self waittill flaggedanimdone

end

