GuardSomething local.stopCustomIdleOnAssault:
	if( local.stopCustomIdleOnAssault == NIL )
	{
		local.stopCustomIdleOnAssault = 1
	}
	self thread global/actor_utils.scr::SetCustomIdleAnim 51000000_Guard_idle local.stopCustomIdleOnAssault 51000000_Guard_idle_trans

end
