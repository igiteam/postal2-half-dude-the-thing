makeConversation:
	local.rand = randomint 100
	if( local.rand < 50 )
	{
		self thread global/actor_utils.scr::SetCustomIdleAnim 51000000_guy_talking 1
	}
	else
	{
		self thread global/actor_utils.scr::SetCustomIdleAnim 51000000_guy_talking2 1
	}
end

