// ----------------------------------------------------------------------------------

unloadBoxesFromTruck local.loader1 local.loader2:
// needs generalization!
	local.loader1 = $loader		
	local.loader2 = $loader2
	while (1) //( isAlive local.loader1) && (isAlive local.loader2 ))
	{
	
		$loader anim 51000000_Unload_Box_from_Truck	
		$loader2 anim 51000000_Unload_Box_from_Truck_pickup	
		local.loader2 waittill animdone
	}
end


playCards:
	DebugPrintLn("== MP2 plays cards! (and he's GOOOD) ==")

	local.idle1 = ((randomint 2) + 1)
	
	// Start Animation loop
	while ( isAlive self )
	{
		//dprintln ("idle now: " + local.idle1)
		self anim (lookingAtCardsIdlesPlayer + local.idle1)
		wait (randomint 2 + 2)	
				
		//  Idle reaction
		local.result = randomint 2
		if (local.result == 0)
		{
			self waittill animdone	// finish playing idle
			self anim (lookingAtCardsReactionsPlayer + local.idle1)
			
		}
		self waittill animdone
		
		// transition to a different idle
		local.result = randomint 0
		if (local.result == 0)
		{
			local.idleNext  = (randomint 3 + 1)   // 1 2 or 3
			//dprintln ("idle next: " + local.idleNext)
			self anim (Shell_0_20_trans_idle0 + local.idle1 + _to_idle0 + local.idleNext)
			self waittill animdone
			local.idle1 = local.idleNext
		}
	}	
	
end