// -----------------------------------------------------------------------------
//	squad.scr
//
//
//	Description:
//
//		Friendly squad functions.
//
//
// -----------------------------------------------------------------------------


// -----------------------------------------------------------------------------
main:
//
//	usage:
//		exec maps/5_6/squad.scr
//
// -----------------------------------------------------------------------------

	// special guys...
	level.mills				= NULL
	level.tyler				= NULL
	level.minoso			= NULL
	level.sullivan			= NULL
	level.gaines			= NULL

	level.captain			= NULL

	level.medic				= NULL
	level.misc_soldier1		= NULL
	level.misc_soldier2		= NULL
	level.misc_soldier3		= NULL
	level.misc_soldier4		= NULL
	level.misc_soldier5		= NULL
	level.misc_soldier6		= NULL
	level.soldier1			= NULL

	level.misc_marine1		= NULL
	level.misc_marine2		= NULL
	level.misc_marine3		= NULL
	level.misc_marine4		= NULL
	level.misc_marine5		= NULL
	level.misc_marine6		= NULL

	level.pilot				= NULL

	end


// -----------------------------------------------------------------------------
SpawnSquad:
//
//	usage:
//		waitthread maps/5_6/squad.scr::SpawnSquad
//
// -----------------------------------------------------------------------------

	// skm: we need to waittill spawn, or the transitioned_to_current_map may not be
	// loaded from the archive
	level waittill spawn

	// jsl-->If we've transitioned to this map, we can assume that the squad came with us?
	if ( $player.transitioned_to_current_map==1 )
	{
		println "Not spawning squad, we transitioned into this map."

		// MJG: if carrying over, remove any squaddies set at fastspawners
		local.spawnname = "fastspawner_" + level.squad_spawnset
		if ( $(local.spawnname).size > 0 )
		{
			$(local.spawnname) waitthread RemoveFastSquadSpawner
		}
	}
	else
	{
		waitthread global/aispawn.scr::spawnset level.squad_spawnset squad 0 0
	}

	dprintln "SpawnSquad: spawning in friendlies..."

	$squad waitthread InitSquad
	$squad setCarryoverData
	$squad waitthread FixUpSquadFromCarryoverData

	//Save the original size of the squad to determine if anyone has died during the lvl.
	level.startSquadSize = $squad.size

	//Squad member death handler
	$squad thread SquadMemberOnDeath

	end


// ----------------------------------------------------------------------------------
RemoveFastSquadSpawner:
// ----------------------------------------------------------------------------------

	self remove

	end


// ----------------------------------------------------------------------------------
InitSquad:
// ----------------------------------------------------------------------------------

	if ( self != NULL )
	{
		self squad_name playersquad
		self.type_squad = squad_mover
		self.type_curious = void		// don't want our squadmates getting all curious on us and doing weird things...

		self waitthread IdleCoverOn		// default squadmates to use idle cover... (they won't use it if they are in "atease" mode...)

		self.quicknotice = 1000		// notice guys in max of 1 second!

		//self squad_morale 10
		//self squad_usemorale 1
		self health 250
		self accuracy 10
		
		//Put this guy on the radar
		self enable_draw_on_radar

		println "Squad actorname:" self.actorname

		switch ( self.actorname )
		{
			case	captain:
				if ( level.captain )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				level.captain			= self
				self squad_leader
				self.enableCarryover = 1
				break

			case	mills:
				if ( level.mills )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				level.mills				= self
				self.enableCarryover = 1
				break

			case	tyler:
				if ( level.tyler )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				level.tyler				= self
				self.enableCarryover = 1
				break

			case	minoso:
				if ( level.minoso )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				//self type_death undead
				self.immortal			= 1
				self.canDie				= 0
				level.minoso			= self
				self.enableCarryover = 1
				break

			case	sullivan:
				if ( level.sullivan )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				// self type_death undead
				self.immortal			= 1
				self.canDie				= 0
				self.forcefacemotion	= 1			// don't want jimmy aiming/shooting while running.  (Rick doesn't like it)
				level.sullivan			= self
				level.medic				= self
				self.enableCarryover = 1

				// configure Medic-specific
				self experience			level.MEDIC_EXPERIENCE_LEVEL
				self max_player_heals	level.MEDIC_MAX_PLAYER_HEALS
				break

			case	gaines:
				if ( level.gaines )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				self.immortal			= 1
				self.canDie				= 0
				level.gaines			= self
				self.enableCarryover = 1
				break

			case	conlin:
				if ( level.conlin )
				{
					dprintln "Duplicate actorname:" self.actorname
					end
				}
				level.conlin			= self
				//self type_death undead
				self type_death undead
				self.enableCarryover = 1
				break

			case	soldier1:
			case	misc_soldier1:
				if( level.misc_soldier1 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier1		= self
				level.soldier1			= self
				break

			case	soldier2:
			case	misc_soldier2:
				if( level.misc_soldier2 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier2		= self
				break

			case	soldier3:
			case	misc_soldier3:
				if( level.misc_soldier3 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier3		= self
				break

			case	soldier4:
			case	misc_soldier4:
				if( level.misc_soldier4 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier4		= self
				break

			case	soldier5:
			case	misc_soldier5:
				if( level.misc_soldier5 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier5		= self
				break

			case	soldier6:
			case	misc_soldier6:
				if( level.misc_soldier6 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_soldier6		= self
				break

			case	marine1:
			case	misc_marine1:
				if( level.misc_marine1 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine1		= self
				break

			case	marine2:
			case	misc_marine2:
				if( level.misc_marine2 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine2		= self
				break

			case	marine3:
			case	misc_marine3:
				if( level.misc_marine3 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine3		= self
				break

			case	marine4:
			case	misc_marine4:
				if( level.misc_marine4 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine4		= self
				break

			case	marine5:
			case	misc_marine5:
				if( level.misc_marine5 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine5		= self
				break

			case	marine6:
			case	misc_marine6:
				if( level.misc_marine6 )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.misc_marine6		= self
				break
			case	pilot:
			case	Pilot:
			case	PBYPilot:
				if( level.pilot )
				{
					dprintln "Duplicate actorname:" self.actorname
				}
				level.pilot				= self
				break
			default:
				{
					dprintln "Unhandled actorname:" self.actorname
					end
				}
				break
		}
	}

end


// -----------------------------------------------------------------------------
FixUpSquadFromCarryoverData:
// -----------------------------------------------------------------------------

	// if for some reason the health that was carried over was 0, delete this
	// squad member
	//dprintln "Actorname: " self.actorname
	//dprintln "Health is: " self.health

	
	if ( $player.transitioned_to_current_map==1 )
	{
		//We need to do this to be sure that the actorname is properly setup in code.  AID will play
		//sound from only the generic guy unless we do this.
		self.actorname = self.actorname

		if( (self getPrevLevelLifeStatus) == 0 )
		{
			dprintln "Deleting: " self.actorname
			self delete
		}
	}

end


// -----------------------------------------------------------------------------
SquadEnableMove local.interval:
//
//	Enables the squad movement thinkers
// -----------------------------------------------------------------------------

	if( local.interval == NIL || local.interval == NULL )
	{
    	self.interval		= 64
	}
	else
	{
		self.inverval		= local.interval
	}

	self type_idle idlecover
	self type_squad squad_mover

end


// -----------------------------------------------------------------------------
SquadDisableMove:
//
// Disable the squad movement thinkers
// -----------------------------------------------------------------------------

	self type_idle idle
	self type_squad void

	end


// -----------------------------------------------------------------------------
SquadStop:
//		Tells guy to stop going to the next squad node
// -----------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
		thread anim/order.scr::order_holdsteady
	}

	self type_squad void
	self type_idle idle

end


// -----------------------------------------------------------------------------
SquadStopIfNotAtCover local.random:
//		Tells guy to stop going to the next squad node (but only if he's not
//		already there....)
// -----------------------------------------------------------------------------

	if ( local.random==random )
	{
		local.r = randomfloat 1.0
		wait local.r
	}

	if ( self.isidlecover==0 )
	{
		self type_squad void
	}

end


// -----------------------------------------------------------------------------
SquadTeleport local.spot local.rad local.off:
//
//		Set the player position first then the squad will spawn around the
//		player
//
// Values:
//			----- Use NIL for default (or omit trailing parameters)
//	local.spot -- object to be surrounded by squadmates (player by default)
//  local.rad -- distance squadmates should be placed from local.spot with offset (default to 200)
//	local.off -- offset from local.spot in local.spot-space squadmates should be placed around (default (0 0 0))
// -----------------------------------------------------------------------------

	//Calculate offset in playerspace
	if( local.off != NIL && local.off != NULL )
	{
		local.saveOff = (0 0 0)

		if( local.off[0] != 0 )
		{
			local.tempVec = $player.rightvector
			local.tempVec = vector_scale local.tempVec local.off[0]
			local.saveOff = vector_add local.saveOff local.tempVec
		}

		if( local.off[1] != 0 )
		{
			local.tempVec = $player.forwardvector
			local.tempVec = vector_scale local.tempVec local.off[1]
			local.saveOff = vector_add local.saveOff local.tempVec
		}

		if( local.off[2] != 0 )
		{
			local.tempVec = $player.upvector
			local.tempVec = vector_scale local.tempVec local.off[2]
			local.saveOff = vector_add local.saveOff local.tempVec
		}
	}
	else
	{
		local.saveOff = NIL
	}
	$squad waitthread SquadTeleportGuy local.spot local.rad local.saveOff

	end


// -----------------------------------------------------------------------------
SquadTeleportGuy local.spot local.rad local.off:
// -----------------------------------------------------------------------------

	if( local.spot == NIL || local.spot == NULL )
	{
		local.pos = $player.origin
	}
	else
	{
		local.pos = local.spot.origin
	}

	if( local.rad == NIL || local.rad == NULL )
	{
		local.rad = 200
	}

	if( local.off != NIL && local.off != NULL )
	{
		local.pos = vector_add local.pos local.off
	}

	//Calc the number of degrees to rotate around the player when teleporting actors
	local.degrees = 360 / $squad.size

	local.pos[2]	+= 100	// make our guy fall into place...

	local.angle		= $player.angle
	local.vF		= $player.forwardvector
	local.vF		= vector_scale local.vF local.rad
	local.pos		= vector_add local.pos local.vF
	local.angle		+= local.degrees
	$player.angle	= local.angle

	local.pos[2] = terrain_height 0 local.pos[0] local.pos[1]
	self.origin = local.pos

	wait .5

	end


// ----------------------------------------------------------------------------------
SquadMemberOnDeath:
//
//	When a squad member dies we will change his targetname to remove him from
//  the squad.
// ----------------------------------------------------------------------------------

	if( self.canDie != NIL && self.canDie != NULL )
	{
		if( self.canDie == 0 )
		{
			end
		}
	}

	self waittill dead
	self setPrevLevelLifeStatus
	self.targetname = "deadSquadGuy"

	end


// ----------------------------------------------------------------------------------
SquadRunAndShoot local.where:
// ----------------------------------------------------------------------------------

	if( local.where == NIL || local.where == NULL )
	{
		println "<ERROR>No location to run and shoot to passed to Squad.scr::SquadRunAndShoot"
		end
	}

	self runandshoot local.where

	end


// ----------------------------------------------------------------------------------
WaitForIdleCover local.squadnode:
//
//	This function won't return until self is at an idle cover position
// ----------------------------------------------------------------------------------

	if ( !isAlive self )
		end

	if ( local.squadnode == NIL )
	{
		local.squadnode = self.squad.squad_destination
	}

	self idlecover

	local.isidlecover	= self isidlecover local.squadnode

	while (local.isidlecover==0)
	{
		wait 0.2

		if ( !isAlive self )
			end

		local.isidlecover	= self isidlecover local.squadnode
	}

	end


// ----------------------------------------------------------------------------------
WaitForPlayerProximity local.home local.range local.assemble_icon:
//
//	Wait until the player is within <local.range> distance of the <local.home> location passed
// ----------------------------------------------------------------------------------

	if( local.home == NIL || local.home == NULL )
	{
		println "<ERROR global/squad.scr>No home origin passed to WaitForPlayerProximity"
		end
	}

	if( local.range == NIL || local.range == NULL )
	{
		println "<ERROR global/squad.scr>No range passed to WaitForPlayerProximity"
		end
	}

	if ( local.assemble_icon==NIL )
		local.assemble_icon = 1

	if ( local.assemble_icon )
	{
		// put up our assemble hand signal (and leave it up until player arrives)
		waitthread global/hand_signals.scr::SetHandSignal assemble -1 1 1
	}

	local.dist = vector_length( $player.origin - local.home )

	while ( local.dist > local.range )
	{
		wait 0.1
		local.dist = vector_length( $player.origin - local.home )
	}

	if ( local.assemble_icon )
	{
		// put up our assemble hand signal (and leave it up until player arrives)
		waitthread global/hand_signals.scr::ClearHandSignal
	}

end


// ----------------------------------------------------------------------------------
WaitForPlayerProximityToEntity local.entity local.range local.assemble_icon:
//
//	Wait until the player is within <local.range> distance of the entity
// I.e. this keeps track of movement of the entity.
// ----------------------------------------------------------------------------------

	if( local.entity == NIL || local.entity == NULL )
	{
		println "<ERROR global/squad.scr>No entity origin passed to WaitForPlayerProximityToEntity"
		end
	}

	if( local.range == NIL || local.range == NULL )
	{
		println "<ERROR global/squad.scr>No range passed to WaitForPlayerProximityToEntity"
		end
	}

	if ( local.assemble_icon==NIL )
		local.assemble_icon = 1

	if ( local.assemble_icon )
	{
		// put up our assemble hand signal (and leave it up until player arrives)
		waitthread global/hand_signals.scr::SetHandSignal assemble -1 1 1
	}

	local.dist = vector_length( $player.origin - local.entity.origin )

	while ( local.dist > local.range && local.entity != NIL && local.entity != NULL )
	{
		wait 0.1
		local.dist = vector_length( $player.origin - local.entity.origin )
	}

	if ( local.assemble_icon )
	{
		// put up our assemble hand signal (and leave it up until player arrives)
		waitthread global/hand_signals.scr::ClearHandSignal
	}

end


// ----------------------------------------------------------------------------------
SquadHoldFire:
// ----------------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
		thread anim/order.scr::order_holdfire
	}

	// dwc TODO play hold fire anim... nono call order.scr which calls hand_signal
	self holdfire 1

	end


// ----------------------------------------------------------------------------------
SquadFireAtWill:
// ----------------------------------------------------------------------------------

	self holdfire 0

	end


