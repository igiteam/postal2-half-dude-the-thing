// -----------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
		waitthread anim/order.scr::order_fallback
	}

	// dprintln "squad.scr TODO: This command not implemented."

end


// -----------------------------------------------------------------------------
CommenceFire:
//
// TODO:  should take a squadnode parameter
// -----------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
		waitthread anim/order.scr::order_commencefire
	}

	// dprintln "squad.scr TODO: This command not implemented."

end


// -------------------------------------------------------------------------------
StealthSetup local.squad local.enemy:
//
//  Basic stealth script to keep your squad from shooting at the enemy till they see you first
// -------------------------------------------------------------------------------

	local.squad waitthread SquadMood "cautious"

	// keep squad quiet and with player
	local.squad waitthread EnableEnemy 0

	// Trigger action when enemy sees playersquad
	waitthread global/actor_utils.scr::GroupWaitForFirstEnemy local.enemy
	// dprintln local.enemy "has seen you"
	local.enemy waitthread SquadMood "alert"
	local.squad thread EnableEnemy 1

end


// -------------------------------------------------------------------------------
EnableEnemy local.iFlag:
//
// Actor enable/disable enemy by passing 1 or 0 to this thread, respectively
// -------------------------------------------------------------------------------

	self.enableEnemy = local.iFlag

end


// ----------------------------------------------------------------------------------
SquadCombatSetup local.squad_advance local.setoffset:
//
//			This is for squad behavior (NOT PLAYERSQUAD) during combat, assuming morale has been switched off. It's best to set this up as a fallback,
//			even if you plan to use morale.
//
//			If local.squad _advance is 1, you can define the squad's offset (which means
//			you pretty much always want this set to 1).
//
//			If local.squad _advance is 2, the local.setoffset value is not used and the squad will attempt to stay
//			at whatever squadnode the player is at regardless of set#.
//
//			If setoffset is 1 or greater, the squad will always try to remain that number (of squadsets) ahead of the player.
//
//			If setoffset is 0, the squad will keep advancing forward to the squadset# that the player is at, but will only move ahead (ie,
//			if the player turns tail and runs, they will remain)
//
//			If setoffset is -1 or less, the squad will try to remain that many squadset#s behind the player.
//
//			An interesting way to do this is to set the setoffset to something like 5.
//			Then, for areas you want the player squad to stay at the same area as the player,
//			space your squad node set#s by 10 (or something > 5).  In areas you want the player squad
//			to advance in front of the player, space your squad node set #s by 5 or less.
//
//			Note: squad nodes that do not have a squadset # are ignored.
//
// ----------------------------------------------------------------------------------

	if ( local.squad_advance==NIL )
		local.captain_advance = 0

	if ( local.setoffset==NIL )
		local.setoffset    = 0

	self.squad_player_advance				= local.squad_advance
	self.player_advance_offset				= local.setoffset

end


// ----------------------------------------------------------------------------------
SquadIdleSetup local.squad_advance local.setoffset:
//
//			This is for squad behavior outside of combat. This is the best way to get the squad to advance with you smartly.
//
//			If local.squad _advance is 1, the player squad will set their current squad destination to whatever
//			squadset # the player is currently at plus local.setoffset.
//
//			If local.squad _advance is 2, the local.setoffset value is not used and the squad will attempt to stay
//			at whatever squadnode the player is at regardless of set#.
//
//			If setoffset is 1 or greater, the squad will always try to remain that number (of squadsets) ahead of the player.
//
//			If setoffset is 0, the squad will keep advancing forward to the squadset# that the player is at, but will only move ahead (ie,
//			if the player turns tail and runs, they will remain)
//
//			If setoffset is -1 or less, the squad will try to remain that many squadset#s behind the player.
//
//			Note: squad nodes that do not have a squadset # are ignored.
//
// ----------------------------------------------------------------------------------

	if ( local.squad_advance==NIL )
		local.captain_advance = 0

	if ( local.setoffset==NIL )
		local.setoffset    = 0


	local.squad.player_idle_advance					= local.squad_advance
	local.squad.player_idle_advance_offset			= local.setoffset

end


// ----------------------------------------------------------------------------------
PlayerSquadMoraleCombatSetup local.setleash local.distanceleash local.type:
//
//	Use this function to setup the player squad to use morale during combat
//	
//	parameters:
//
//		setleash		- Set # delta to keep player within (default=2)
//		distanceleash	- Distance to keep player within  (default=0 which means disabled.)
//		type			-	1 means normal morale. 
//							2 means morale with no player fallback. 
//							3 means no morale decisions (no player fallback), but allow CSC
//
// ----------------------------------------------------------------------------------

	if ( local.setleash==NIL )
		local.setleash = 2

	if (local.distanceleash==NIL)
		local.distanceleash = 0

	if ( local.type==NIL )
		local.type		= 1

	if ( local.type <= 0 || local.type > 3 )
		local.type		= 1

	// makes sure we use the leash
	$playersquad.squad_player_advance	= 1	
	$playersquad.player_advance_offset	= 0

	// make sure morale is turned on
	$playersquad.squad_usemorale		= local.type

	// setup our leash's
	$playersquad.playermoraleabort		= local.setleash
	$playersquad.moraleleash			= local.distanceleash


	end

// ----------------------------------------------------------------------------------
PlayerSquadCombatSetup local.player_advance local.setoffset:
//
//	This is for squad behavior during combat, assuming morale has been switched off. It's best to set this up as a fallback,
//	even if you plan to use morale.
//
//	If player_advance is 1, you can define the squad's offset (which means
//	you pretty much always want this set to 1).
//
//	If player_advance is 2, the local.setoffset value is not used and the squad will attempt to stay
//	at whatever squadnode the player is at regardless of set#.
//
//	If setoffset is 1 or greater, the squad will always try to remain that number (of squadsets) ahead of the player.
//
//	If setoffset is 0, the squad will keep advancing forward to the squadset# that the player is at, but will only move ahead (ie,
//	if the player turns tail and runs, they will remain)
//
//	If setoffset is -1 or less, the squad will try to remain that many squadset#s behind the player.
//
//	An interesting way to do this is to set the setoffset to something like 5.
//	Then, for areas you want the player squad to stay at the same area as the player,
//	space your squad node set#s by 10 (or something > 5).  In areas you want the player squad
//	to advance in front of the player, space your squad node set #s by 5 or less.
//
//	Note: squad nodes that do not have a squadset # are ignored.
//
// ----------------------------------------------------------------------------------

	if ( local.player_advance==NIL )
		local.player_advance = 0

	if ( local.setoffset==NIL )
		local.setoffset	= 0

	$playersquad.squad_player_advance		= local.player_advance
	$playersquad.player_advance_offset		= local.setoffset

end


// ----------------------------------------------------------------------------------
PlayerSquadIdleSetup local.player_advance local.setoffset:
//
//	This is for squad behavior outside of combat. This is the best way to get the squad to advance with you smartly.
//
//	If player_advance is 1, the player squad will set their current squad destination to whatever
//	squadset # the player is currently at plus local.setoffset.
//
//	If player_advance is 2, the local.setoffset value is not used and the squad will attempt to stay
//	at whatever squadnode the player is at regardless of set#.
//
//	If setoffset is 1 or greater, the squad will always try to remain that number (of squadsets) ahead of the player.
//
//	If setoffset is 0, the squad will keep advancing forward to the squadset# that the player is at, but will only move ahead (ie,
//	if the player turns tail and runs, they will remain)
//
//	If setoffset is -1 or less, the squad will try to remain that many squadset#s behind the player.
//
//	Note: squad nodes that do not have a squadset # are ignored.
//
// ----------------------------------------------------------------------------------

	if ( local.player_advance==NIL )
		local.player_advance = 0

	if ( local.setoffset==NIL )
		local.setoffset	= 0

	$playersquad.player_idle_advance			= local.player_advance
	$playersquad.player_idle_advance_offset		= local.setoffset

end


// ----------------------------------------------------------------------------------
IdleCoverOn:
//
//	AI will use idle cover when he is not in atease mood.
//
// ----------------------------------------------------------------------------------

	self idlecover

	end


// ----------------------------------------------------------------------------------
IdleCoverOff:
//
//	AI will not use idle cover (even if given a squad destination)
//
// ----------------------------------------------------------------------------------

	self idlecoverstop

	end


// ----------------------------------------------------------------------------------
SquadFollowSquadmate local.squadmate:
// ----------------------------------------------------------------------------------

	if ( self==local.squadmate )
	{
		self idlecover
		self.squad.player_idle_advance = 0
		end
	}

	self follow local.squadmate

	end


// ----------------------------------------------------------------------------------
SquadFollowSquadmateStop:
// ----------------------------------------------------------------------------------

	self followstop
	self type_squad squad_mover

	end


// ----------------------------------------------------------------------------------
PlayerSquadMimicPlayer local.mimic_dist:
// ----------------------------------------------------------------------------------

	// follow the player using squad nodes mode
//	waitthread PlayerSquadIdleSetup 2 0

	//	setup our mimic dist
	$playersquad.mimic_dist = local.mimic_dist

	// tell squad to use player as the pointman...
	$playersquad.pointman	= $player

	end


// ----------------------------------------------------------------------------------
SquadTeleportToSquadnode local.squadnode local.maxdist:
//
//	Actor
//	Teleport an Actor to a node attached to the squadnode passed.
//
//	If the Actor is farther from the squadnode than the distance passed (pass 0 or NIL to ignore distance
//	and force the teleport), the thread will examine the nodes that are linked to the squadnode.
//
//	If a node is found whose 'actorname' matches the 'actorname' of the Actor, that node will be used as the
//	teleport destination (origin and angles).  Otherwise, another anonymous node will be used.
//
// ----------------------------------------------------------------------------------

	if ( local.maxdist == NIL )
	{
		local.maxdist = 0
	}

	local.vect = vector_subtract local.squadnode.origin self.origin
	local.dist = vector_length local.vect

	if ( local.dist < local.maxdist )
	{
		end
	}

	local.tag = level.inttime
	local.opennode = NULL

	if ( (local.squadnode != NULL) && ($(local.squadnode.target) != NULL) && ($(local.squadnode.target).size > 0) )
	{
		for ( local.i = 1; local.i <= $(local.squadnode.target).size; local.i++ )
		{
			local.node = $(local.squadnode.target)[local.i]
			if ( local.node.actorname == self.actorname )
			{
				local.node.teleporttag = local.tag
				self.origin = local.node.origin
				self.angles = local.node.angles
				end
			}
			else if ( (local.node.actorname == "") && ((local.node.teleporttag == NIL) || (local.node.teleporttag != local.tag)) )
			{
				local.opennode = local.node
			}
		}

		if ( local.opennode != NULL )
		{
			local.opennode.teleporttag = local.tag
			self.origin = local.opennode.origin
			self.angles = local.opennode.angles
		}
	}

end


// ----------------------------------------------------------------------------------
SquadPrepForTransition:
//
//	Actor
//	Prep a squad Actor for BSP transition
// ----------------------------------------------------------------------------------

 	if ( self.health < 1 )
	{
		self heal
	}

end

// ----------------------------------------------------------------------------------
SquadFollowPlayer local.player_advance local.setoffset:
//
//	This is for squad behavior IN combat AND OUT of combat. This is the best way to get the squad to advance with you smartly ALWAYS.
//
//	If player_advance is 1, the player squad will set their current squad destination to whatever
//	squadset # the player is currently at plus local.setoffset.
//
//	If player_advance is 2, the local.setoffset value is not used and the squad will attempt to stay
//	at whatever squadnode the player is at regardless of set#.
//
//	If setoffset is 1 or greater, the squad will always try to remain that number (of squadsets) ahead of the player.
//
//	If setoffset is 0, the squad will keep advancing forward to the squadset# that the player is at, but will only move ahead (ie,
//	if the player turns tail and runs, they will remain)
//
//	If setoffset is -1 or less, the squad will try to remain that many squadset#s behind the player.
//
//	Note: squad nodes that do not have a squadset # are ignored.
// ----------------------------------------------------------------------------------

	if ( local.player_advance==NIL )
		local.player_advance = 0

	if ( local.setoffset==NIL )
		local.setoffset	= 0
	
	//Idle State smart follow
	self.player_idle_advance		= local.player_advance
	self.player_idle_advance_offset		= local.setoffset
	//Combat State smart follow
	self.squad_player_advance		= local.player_advance
	self.player_advance_offset		= local.setoffset

end

// ----------------------------------------------------------------------------------
PlayerSquadForceDestStart local.dest local.requiredactors:
//
//	This function can only be used on the player squad.  We make massive assumptions
//	about targetnames here.  Thank you.
//
// ----------------------------------------------------------------------------------

	assert (local.dest != NIL && local.dest != NULL && "local.dest hasn't been properly initialized.")

	$player waitthread SquadName "playersquad"

	$squad waitthread StopWingman	

	//Disable the medic
	if( level.sullivan.isenabled == 1 )
	{
		//Wait for sullivan
		if( level.sullivan.patient != NIL && level.sullivan.patient != NULL && level.sullivan.patient == $player )
		{
			println "global/squad.scr::PlayerSquadForceDest; Waiting for sullivan to finish healing the player"
			level.sullivan waittill heal_done
			println "global/squad.scr::PlayerSquadForceDest; Player healed."
		}

		level.sullivan.wasMedic = 1
		level.sullivan medic_disable
	}

	$player set_medic_call_bool 0
	
	//We set this so when they get moved back to the player squad they stay put.
	$playersquad squad_destination local.dest

	$squad waitthread global/actor_utils.scr::Resurrect

	$squad waitthread global/actor_utils.scr::SetEnableEnemy 0
	$squad waitthread global/actor_utils.scr::SetNoDamage 1
	$squad waitthread global/actor_utils.scr::SetNoPain 1	
	$squad waitthread global/actor_utils.scr::SetIgnoreBadPlaces 1

	$squad waitthread global/actor_utils.scr::AnimStop
	$squad waitthread global/actor_utils.scr::CancelOrder
	$squad waitthread global/actor_utils.scr::ExitMG

	$squad waitthread SquadName "tempPlayerSquad"
	$tempPlayerSquad squad_usemorale 0

	$squad waitthread SquadEnableMove

	$tempPlayerSquad squad_destination local.dest

//jsl-->causing guys to not go to their correct places.	$squad thread RunAndShootIfNeeded local.dest
	
	if(local.requiredactors == NIL)
	{
		$squad waitthread WaitForIdleCover local.dest
	}
	else
	{
		for( local.i = 1; local.i <= local.requiredactors.size; local.i++ )
		{
			local.myguy = waitthread global/actor_utils.scr::GetActorname $squad local.requiredactors[local.i]
			local.myguy.targetname = "keyactor"
		}
		$keyactor waitthread WaitForIdleCover local.dest
		$keyactor waitthread RenameMe squad
	}

end

// ----------------------------------------------------------------------------------
RunAndShootIfNeeded local.dest:
// ----------------------------------------------------------------------------------
    	
	if ( self.squadarea==local.dest )
	{
		end
	}

	self waitthread global/actor_utils.scr::RunAndShootTo local.dest

end


// ----------------------------------------------------------------------------------
RenameMe local.targetname:
//
//
// ----------------------------------------------------------------------------------

	self.targetname = local.targetname
	
end


// ----------------------------------------------------------------------------------
PlayerSquadForceDestEnd:
//
//
// ----------------------------------------------------------------------------------

	$squad waitthread SquadmateForceDestEnd

end

// ----------------------------------------------------------------------------------
SquadmateForceDestEnd:
// ----------------------------------------------------------------------------------
	self waitthread global/actor_utils.scr::SetEnableEnemy 1
	self waitthread global/actor_utils.scr::SetNoDamage 0
	self waitthread global/actor_utils.scr::SetNoPain 0	
	self waitthread global/actor_utils.scr::SetIgnoreBadPlaces 0

	self waitthread SquadName "playersquad"

	if( self.wasWingman == 1 )
	{
		self.type_squadactive = "wingman"
	}

	//Enable the medic
	if( self.wasMedic!=NIL && self.wasMedic == 1 )
	{
		self.wasMedic = 0
		self medic_enable
		$player set_medic_call_bool 1
	}


	end
