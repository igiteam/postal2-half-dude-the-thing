// ----------------------------------------------------------------------------------
SquadRunOnCombat:
// Waittill the squad has an enemy then put them into run mode
// self is the squad name
// ----------------------------------------------------------------------------------

	self waittill hasenemy

	self squad_movetype_run

	end


// ----------------------------------------------------------------------------------
SquadName local.name:
// ----------------------------------------------------------------------------------

	if( local.name == NIL || local.area == NULL )
	{
		println "<ERROR global/squad.scr> No squad name passed to function SquadName"
	}

	self squad_name local.name

	end


// -----------------------------------------------------------------------------
SetPlayerSquadAdvanceWithPlayer local.advanceWithPlayer:
//
//	pass a distance to have the player squad "forced" to immediately advance
//	to the player's current area...
//
//	pass 0 to turn it off...
//
//	self is the name of the actor
// -----------------------------------------------------------------------------

	if( self == NIL || self == NULL )
	{
		println "<ERROR global/squad.scr> Invalid squad used with function SetPlayerSquadAdvanceWithPlayer"
		end
	}

	if ( local.advanceWithPlayer == NIL )
	{
		local.advanceWithPlayer	= 512
	}

	self squad_player_advance local.advanceWithPlayer

	end


// -----------------------------------------------------------------------------
SetAsPlayerBuddy local.followplayer local.mindist local.maxdist:
//
// self is an actor
//
//	Sets up AI to follow the player when idle and during combat.
//	AI will do its best to stick with the player.  When player gets too far
//	away, AI will run towards player until within a certain distance.  Once
//	within that distance, he will re-attempt to find cover in the player's
//	current squadnode area.
//
//	pass followplayer as 1 if you want the AI to follow the player in a
//	single-file format.  Pass 0 if you want the AI to follow the player using
//	on a squadnode to squadnode basis...
//
//	maxdist is farthest AI will stray away from player during combat
//	mindist is how close AI will attempt to get to the player once he's
//			gone farther than maxdist away from the player.
//
//
// -----------------------------------------------------------------------------

	if ( local.followplayer==NIL )
	{
		local.followplayer = 1
	}

	if ( local.mindist==NIL )
		local.mindist		= 220
	if ( local.maxdist==NIL )
		local.maxdist		= 768

	self.type_squadactive	= "wingman"
	self.targetname			= "playerbud"
	self.squad_name			= "playerbud_squad"
	self.wingman_maxdist	= local.maxdist
	self.wingman_mindist	= local.mindist

	$playerbud_squad.squad_player_advance = 2

	if ( local.followplayer )
	{
		self.type_squad = follow
		self follow $player
	}
	else
	{
		self.type_squad			= squad_mover

		$playerbud_squad.squad_automerge = 0
		$playerbud_squad.squad_usemorale = 0
		$playerbud_squad.player_idle_advance = 2
	}

	end


// -----------------------------------------------------------------------------
SetAsPlayerWingman local.mindist local.maxdist:
// -----------------------------------------------------------------------------

	if ( local.mindist==NIL )
		local.mindist		= 220
	if ( local.maxdist==NIL )
		local.maxdist		= 768

	self.type_squadactive	= "wingman"
	self.wingman_maxdist	= local.maxdist
	self.wingman_mindist	= local.mindist

end


// -----------------------------------------------------------------------------
StopWingman:
// -----------------------------------------------------------------------------

	if( self.type_squadactive == "wingman" )
	{
		self.wasWingman = 1
		self.type_squadactive	= void			
	}   	

end


// -----------------------------------------------------------------------------
StopPlayerBuddy:
// -----------------------------------------------------------------------------

	self followstop
	self.type_squad				= squad_mover
	self.type_squadactive		= void
	self.squad_name				= "playersquad"
	self.targetname				= "squad"

	end


// ----------------------------------------------------------------------------------------------------------


// -----------------------------------------------------------------------------
SignalAirAttack:
//
// this is not in order.scr b/c it is not really an order, rather just a signal
// -----------------------------------------------------------------------------
	if ( self.actorname == "captain" )
	{
		self waitthread anim/order.scr::OrderInit // clear other anims playing

		// TODO play a dialog?
		self setmotionanim (self getalias signal airraid)
		self waittill flaggedanimdone
	}

	// TODO? any action that squad should take now?

end


// -----------------------------------------------------------------------------
SignalDangerArea:
//
// this is not in order.scr b/c it is not really an order, rather just a signal
// -----------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
dprintln "danger will robisnison"
		self waitthread anim/order.scr::OrderInit // clear other anims playing

		self setmotionanim (self getalias signal danger_area)
		self waittill flaggedanimdone
	}

	// TODO? any action that squad should take now?

end


// -----------------------------------------------------------------------------
BoundingOverwatch:
//
// -----------------------------------------------------------------------------

	if ( self.actorname == "captain" )
	{
		thread anim/order.scr::order_bounding_overwatch
	}

