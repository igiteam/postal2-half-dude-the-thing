// ------------------------------------------------------------------------------------
main:
end

// ------------------------------------------------------------------------------------
AvoidRunL:
// ------------------------------------------------------------------------------------

	while (1)
	{
		local.anim = self getalias bumpavoid_run "" "" "l" "x"
//		dprintln "~~~~~~~~~~~~~~~ avoid anim script is playing animation " local.anim
		self setmotionanim local.anim
		self waittill flaggedanimdone
	}

end


