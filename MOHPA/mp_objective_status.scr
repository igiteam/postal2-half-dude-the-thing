//-----------------
	// this function eases the use of mp_objective_status.scr with
	// retrieve_item objectives
	// NOTE: this must NOT be called before the objective is in
	// progress or it will be clobbered.  it should be called
	// right when the pertinent objective starts.
	
	// self is undefined

	// disallow more than 9 lines to be used
	if (level.objectiveStatusCount >= 9)
		end // return NULL for error
	
	// increase the number of lines used
	level.objectiveStatusCount++

	// assign the statusNum and name
	local.retval = spawn script_origin
	local.retval.statusNum = level.objectiveStatusCount
	local.retval.trigger = local.retrievalTrigger
	
	waitthread set_icon local.retval.statusNum 1 0 local.retval.trigger
	waitthread set_status local.retval.statusNum 0 0 1 "MPOBJSTATUS:Secure" 0 0 0 0	
	
end local.retval


//-----------------
item_retrieval_start_countdown local.timer:
//-----------------

	// self is the script_origin returned by flip_switch_initialize
	
	waitthread set_icon self.statusNum 1 1 self.trigger
	
	// start the timer on the flip_switch
	waitthread set_status self.statusNum 0 0 1 "MPOBJSTATUS:Threatened" 1 1 local.timer 1
end


//-----------------
item_retrieval_notify_successful_steal:
//-----------------

	// self is the script_origin returned by flip_switch_initialize
	
	waitthread set_icon self.statusNum
	waitthread set_status self.statusNum 0 0 1 "MPOBJSTATUS:Stolen" 0 0 0 0
end


//-----------------
item_retrieval_notify_successful_radio:
//-----------------

	// self is the script_origin returned by flip_switch_initialize
	
	waitthread set_icon self.statusNum
	waitthread set_status self.statusNum 0 0 1 "MPOBJSTATUS:Transmitted" 0 0 0 0
end


//-----------------
item_retrieval_notify_failed_attempt:
//-----------------

	// self is the script_origin returned by flip_switch_initialize
	
	waitthread set_icon self.statusNum 1 0 self.trigger
	waitthread set_status self.statusNum 0 0 1 "MPOBJSTATUS:Secure" 0 0 0 0
end


//-----------------
general_objective_add_item local.objItem local.notThreatenedText local.threatenedText:
//-----------------           

	// This function is used to add a diamond to the compass and HUD
	// to represent an objective item. More specifically, it is used for the plunger
	// in Bridge.

	// self is undefined
		
	// disallow more than 9 lines to be used
	if (level.objectiveStatusCount >= 9)
		end NULL // return NULL for error
	
	// increase the number of lines used
	level.objectiveStatusCount++

	// assign the statusNum and name
	local.retval = spawn script_origin
	local.retval.statusNum = level.objectiveStatusCount
	local.retval.objItem = local.objItem
	local.retval.name = local.name
	local.retval.notThreatenedText = local.notThreatenedText
	local.retval.threatenedText = local.threatenedText
	
	// set the icon
	waitthread set_icon local.retval.statusNum 1 0 local.retval.objItem
	waitthread set_status local.retval.statusNum 0 0 1 local.retval.notThreatenedText 0 0 0 0	

end local.retval // return the retval


//-----------------
general_item_threatened:
//-----------------
	waitthread set_icon self.statusNum 1 1 self.objItem	
	waitthread set_status self.statusNum 0 0 1 self.threatenedText 0 0 0 1		

end


//-----------------
general_item_not_threatened:
//-----------------
	waitthread set_icon self.statusNum 1 0 self.objItem
	waitthread set_status self.statusNum 0 0 1 self.notThreatenedText 0 0 0 0	

end
