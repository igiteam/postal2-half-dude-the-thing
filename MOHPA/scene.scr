// --------------------------------------------------------------------------------
//	global/scene.scr
//
//	generic scene management aides
//
//
//
//
// Engineer Notes:
//
//	level.scenetrigger array is 0-based
//	trigger.autohide[] array is 0-based
//	trigger.autoshow[] array is 0-based
//	trigger.autoremove[] array is 0-based
//
// --------------------------------------------------------------------------------

main:

	level waittill prespawn

	level.SCENE_currentscene = -1

	waitthread InitSceneTriggers

end


// --------------------------------------------------------------------------------
AddAutoHide local.scene local.t:
//
//	Entity
// --------------------------------------------------------------------------------

	if ( local.t == NIL )
		local.t = waitthread FindSceneTrigger local.scene

	if ( local.t != NULL )
	{
		local.idx = local.t.autohide.size
		if ( local.idx < 0 )
			local.idx = 0

		local.t.autohide[local.idx] = self
//		dprintln "~~~~~~ added autohide entity # " local.idx
	}
	else
	{
		dprintln "**** ERROR in scene.scr::AddAutoHide, couldn't find trigger for scene " local.scene
	}

end


// --------------------------------------------------------------------------------
AddAutoShow local.scene local.t:
//
//	Entity
// --------------------------------------------------------------------------------

	if ( local.t == NIL )
		local.t = waitthread FindSceneTrigger local.scene

	if ( local.t != NULL )
	{
		local.idx = local.t.autoshow.size
		if ( local.idx < 0 )
			local.idx = 0

		local.t.autoshow[local.idx] = self
//		dprintln "~~~~~~ added autoshow entity # " local.idx
	}
	else
	{
		dprintln "**** ERROR in scene.scr::AddAutoShow, couldn't find trigger for scene " local.scene
	}

end


// --------------------------------------------------------------------------------
AddAutoRemove local.scene local.t:
//
//	Entity
// --------------------------------------------------------------------------------

	if ( local.t == NIL )
		local.t = waitthread FindSceneTrigger local.scene

	if ( local.t != NULL )
	{
		local.idx = local.t.autoremove.size
		if ( local.idx < 0 )
			local.idx = 0

		local.t.autoremove[local.idx] = self
//		dprintln "~~~~~~ added autoremove entity # " local.idx
	}
	else
	{
		dprintln "**** ERROR in scene.scr::AddAutoRemove, couldn't find trigger for scene " local.scene
	}

end


// ================================================================================
// ================================================================================

// --------------------------------------------------------------------------------
InitSceneTriggers:
//
//	Script
// --------------------------------------------------------------------------------

	if ( $scenetrigger == NULL )
	{
		level.scenetriggers = 0
	}
	else
	{
		level.scenetriggers = $scenetrigger.size
		local.count = 0
	
		for ( local.i = 1; local.i <= level.scenetriggers; local.i++ )
		{
			if ( $scenetrigger[local.i].scene != NIL )
			{
//				local.t = waitthread FindSceneTrigger $scenetrigger[local.i].scene
//				if ( local.t == NULL )
				{
					level.scenetrigger[local.count] = $scenetrigger[local.i]
					level.scenetrigger[local.count] thread RunSceneTrigger
//					dprintln "~~~~~~ assigned level.scenetrigger[" local.count "], level.scenetrigger.size is " level.scenetrigger.size
					local.count++
				}
//				else
//				{
//					dprintln "**** ERROR in scene.scr: $scenetrigger has duplicate #scene set (" $scenetrigger[local.i].scene ")."
//				}
			}
			else
			{
				dprintln "**** ERROR in scene.scr: $scenetrigger has no #scene set."
			}
		}
	}

end


// --------------------------------------------------------------------------------
FindSceneTrigger local.scene:
//
//	Script
// --------------------------------------------------------------------------------

	if ( level.scenetrigger.size > 0 )
	{
		for ( local.i = 0; local.i < level.scenetrigger.size; local.i++ )
		{
//			dprintln "~~~~~~ FindSceneTrigger looking for " local.scene ", found " level.scenetrigger[local.i].scene
			if ( level.scenetrigger[local.i].scene == local.scene )
				end level.scenetrigger[local.i]
		}
	}

end NULL


// --------------------------------------------------------------------------------
RunSceneTrigger:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------

//	dprintln "~~~~~~~~ Scene trigger running"
	while (1)
	{
		self waittill trigger

		if ( level.SCENE_currentscene != self.scene )
		{
//			dprintln "~~~~~~~~ Scene trigger tripped, triggered scene " self.scene " (NEW SCENE, DO ACTIONS)"
			self waitthread TriggerSceneEnd		level.SCENE_currentscene
			self waitthread TriggerSceneBegin

			level.SCENE_currentscene = self.scene
		}
		else
		{
//			dprintln "~~~~~~~~ Scene trigger tripped, triggered scene " self.scene " (CURRENT SCENE, NO ACTIONS)"
		}
		wait 1.0
	}

end


// --------------------------------------------------------------------------------
TriggerSceneBegin:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------

	local.t = waitthread FindSceneTrigger self.scene
	if ( local.t != NULL )
	{
		local.t waitthread TriggerAutoHide
		local.t waitthread TriggerAutoShow
		local.t waitthread TriggerAutoRemove
	}

end


// --------------------------------------------------------------------------------
TriggerSceneEnd local.scene:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------


end


// --------------------------------------------------------------------------------
TriggerAutoHide:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------

	local.count = self.autohide.size

	if ( local.count > 0 )
	{
		for ( local.i = 0; local.i < local.count; local.i++ )
		{
			if ( self.autohide[local.i] != NULL )
				self.autohide[local.i] hide
		}
	}

end


// --------------------------------------------------------------------------------
TriggerAutoShow:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------

	local.count = self.autoshow.size

	if ( local.count > 0 )
	{
		for ( local.i = 0; local.i < local.count; local.i++ )
		{
			if ( self.autoshow[local.i] != NULL )
				self.autoshow[local.i] show
		}
	}

end


// --------------------------------------------------------------------------------
TriggerAutoRemove:
//
//	Trigger (scenetrigger)
// --------------------------------------------------------------------------------

	local.count = self.autoremove.size

	if ( local.count > 0 )
	{
		for ( local.i = 0; local.i < local.count; local.i++ )
		{
			if ( self.autoremove[local.i] != NULL )
				self.autoremove[local.i] remove
		}
	}

end

