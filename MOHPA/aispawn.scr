// --------------------------------------------------------------------------------
Rename local.newname:
// --------------------------------------------------------------------------------

	/// jsl--> don't know why someone put this here? self.enemyname	= self.targetname
	self.targetname = local.newname

end


// --------------------------------------------------------------------------------
SetActiveThink local.active_think:
// --------------------------------------------------------------------------------
	// dprintln "ACTIVE THINK: " local.active_think
	
	self.active_think = local.active_think

end


// --------------------------------------------------------------------------------
UpdateSet local.newset:
// --------------------------------------------------------------------------------

	self.set	= local.newset

end


// --------------------------------------------------------------------------------
DeleteSet local.set:
// --------------------------------------------------------------------------------

	if ( self.set==local.set )
		self delete

end

// --------------------------------------------------------------------------------
DoAiSpawnTrigger:
//
//	waits to be triggered and then does the spawn and deletes ourself...
// --------------------------------------------------------------------------------
	// dprintlnln "AI Spawner Trigger BEGIN!"
	
	if (getcvar(notrigger) == "1")
	{
		wait 4
		// dprintlnln "AI Spawner Trigger DELETE!"
		self delete
		end
	}

	if ( !self.set )
	{
		// dprintlnln "AI Spawner Trigger with no set#!"
		end
	}

	// if friendly is set, only do the trigger if a friendly was the one that hit us...
	if ( self.friendly!=NIL )
	{
		// dprintlnln "AI Spawner Trigger AWAIT ACTIVATION 1!"
		while ( 1 )
		{
			self waittill trigger
			
			// dprintlnln "AI Spawner Trigger Activated 1"
			
			if ( parm.other==$player || parm.other.team=="american" )
			{
				// dprintlnln "AI Spawner Spawning 1"
				thread spawn self.set
				break
			}
			else
			{
				// dprintlnln "AI Spawner Can't Spawn"
			}
		}
	}
	else
	{
	//	dprintln "AI Spawner Trigger AWAIT ACTIVATION 2"
		self waittill trigger
		level.active_think	= self.ambush
		
		println "AMBUSH VALUE: " self.ambush
		thread spawn self.set NIL NIL NIL NIL self.enemyname
				
	//	dprintln "AI Spawner Trigger Activated 2!"
	}

	// dprintlnln "AI Spawner Trigger Deleting"
	// make sure we get rid of all triggers with our set #.... (including us btw!)
	$aispawnertrigger thread DeleteSet self.set
	

end

// --------------------------------------------------------------------------------
InitializeSpawnTriggers:
// --------------------------------------------------------------------------------

	if ( $enemyspawnertrigger )
		$enemyspawnertrigger waitthread Rename "aispawnertrigger"

	local.newset = 3152930

	if ($aispawnertrigger == NULL)
		level.aispawnertriggers = 0
	else
		level.aispawnertriggers = $aispawnertrigger.size
	
	if (level.aispawnertriggers > 0)
	{
		for (local.i=1;local.i<=$aispawnertrigger.size;local.i++)
		{
			if ($aispawnertrigger[local.i].target)
			{

				if ( $aispawnertrigger[local.i].set==NIL || $aispawnertrigger[local.i].set==NULL )
					$aispawnertrigger[local.i].set = local.newset
				else
					local.newset = $aispawnertrigger[local.i].set

				local.string		= $aispawnertrigger[local.i].target
				local.ent = $($aispawnertrigger[local.i].target)
				$aispawnertrigger[local.i].target = ""

				if ( local.ent.size >0 )
				{
					local.ent waitthread UpdateSet local.newset
					// dprintlnln local.ent.target
					local.ent waitthread Rename "aispawner"
				}
				else
				{
					local.origin = $aispawnertrigger[local.i].origin
					local.error = ("Error, an aispawnertrigger at " + local.origin + " has bogus target")					
					exec global/error.scr local.error
				}
			}
			else
			{
				println "aispawnertrigger with no target!"
			}

			local.newset++
		}
	}
	else
	{
		// dprintlnln "****** NO SPAWN TRIGGERS FOUND"
	}


	if (level.aispawnertriggers > 0)
	{
		$aispawnertrigger thread DoAiSpawnTrigger
	}

	println ("There are " + level.aispawnertriggers + " aispawnertriggers")

end

// --------------------------------------------------------------------------------
InitializeSpawners:
//
//	Go through and store all the aispawner actors.  Then remove them...
// --------------------------------------------------------------------------------

// for backward compatibility
	if ( $enemyspawner )
		$enemyspawner waitthread Rename "aispawner"

	if ($aispawner== NULL)
		level.aispawners = 0
	else
		level.aispawners = $aispawner.size

	if (level.aispawners > 0)
	{
		local.aispawner = exec global/makearray.scr $aispawner

		for (local.i=1;local.i<level.aispawners+1;local.i++)
		{
			
			if (local.aispawner[local.i].enemyname == NIL)
			{
				//println "No enemy name!"
				local.aispawner[local.i].enemyname = -1
			}

			if (local.aispawner[local.i].playerseek == NIL)
				local.aispawner[local.i].playerseek = 0

			if (local.aispawner[local.i].model == NIL)
			{
				local.origin = local.aispawner[local.i].origin
				local.error = ("Error, aispawner at " + local.origin + " has no model")			
				exec global/error.scr local.error 0
			}

			if (local.aispawner[local.i].set == NIL)
			{
				local.origin = local.aispawner[local.i].origin
				local.error = ("Error, aispawner at " + local.origin + " has no #set")
				exec global/error.scr local.error 0
			}
			else
				local.set = local.aispawner[local.i].set

			if (local.aispawner[local.i].group == NIL)
			{
				// jsl-->unnecessary warning message
				// println ("Warning, aispawner at " + local.aispawner[local.i].origin + " has no #group")
				local.group = -1
			}
			else
				local.group = local.aispawner[local.i].group

			local.enemyname = local.aispawner[local.i].enemyname
			local.playerseek = local.aispawner[local.i].playerseek

			switch ( local.aispawner[local.i].classname )
			{
			case	Actor:
			case	Medic:
				break
			default:
				// not sure what this is, but it's not an actor!
				println "Bad aispawner at" local.aispawner[local.i].origin " classname:" local.aispawner[local.i].classname
				local.aispawner[local.i] delete
				continue
				break
			}

			if (getcvar(fastspawn) == "0")
				local.aispawner[local.i].fastspawn = 0
			else if (getcvar(fastspawn)=="99")
				local.aispawner[local.i].fastspawn = 1

			if ( local.aispawner[local.i].fastspawn==NIL )
				local.aispawner[local.i].fastspawn	= 0
			
			if ( local.aispawner[local.i].fastspawn==0 )
			{
				local.aispawner[local.i] = waitthread global/spawner.scr::spawner_create local.aispawner[local.i]
			}

			local.aispawner[local.i].enemyname = local.enemyname
			local.aispawner[local.i].playerseek = local.playerseek
			
			if (local.set)
				local.aispawner[local.i].set = local.set
			
			if (local.group)
				local.aispawner[local.i].group = local.group


			if ( local.aispawner[local.i].fastspawn==1 )
			{
				local.spawnname = "fastspawner_" + local.set
				local.aispawner[local.i] waitthread InitFastSpawner
			}
			else
			{
				local.spawnname = "aispawner_" + local.set
			}

			println "Local.spawnname=" local.spawnname
			local.aispawner[local.i].targetname = local.spawnname
		}

		println ("There are " + level.aispawners + " aispawners")
	}

end


//--------------------------------------------------
axiscounter_init:
//
//	Level
//--------------------------------------------------

	level.axiscounter_axisalivecount = 0
	level.axiscounter_axisactivecount = 0

	end		// MJG: comment out this line to get stats as the numbers change

	local.axisalivecount = -1
	local.axisactivecount = -1

	while (1)
	{
		while ( (local.axisalivecount == level.axiscounter_axisalivecount) && (local.axisactivecount == level.axiscounter_axisactivecount) )
		{
			wait 0.1
		}
		dprintln "~~~~ level.axisalivecount is " level.axiscounter_axisalivecount ", level.axisactivecount is " level.axiscounter_axisactivecount
		waitframe
		local.axisalivecount = level.axiscounter_axisalivecount
		local.axisactivecount = level.axiscounter_axisactivecount
	}

end


//--------------------------------------------------
axiscounter_register:
//
//	Actor (Axis spawners only)
//--------------------------------------------------

	self thread axiscounter_countalive
	self thread axiscounter_countactive

end


//--------------------------------------------------
axiscounter_countalive:
//
//	Actor (Axis spawners only)
//--------------------------------------------------

	if ( level.axiscounter_axisalivecount == NIL )
		level.axiscounter_axisalivecount = 0
	level.axiscounter_axisalivecount++
	self waittill death
	level.axiscounter_axisalivecount--

end


//--------------------------------------------------
axiscounter_countactive:
//
//	Actor (Axis spawners only)
//--------------------------------------------------

	if ( level.axiscounter_axisactivecount == NIL )
		level.axiscounter_axisactivecount = 0
	self waittill hasenemy
	level.axiscounter_axisactivecount++
	self waittill death
	level.axiscounter_axisactivecount--


end

//-----------------------------------------------------------
SpawnYourselfFast local.targetname:
//-----------------------------------------------------------

	self.targetname = local.targetname
	self ai_on
	self show
	self solid

	end

// --------------------------------------------------------------------------------
InitFastSpawner:
// --------------------------------------------------------------------------------

	local.spawnname = "fastspawner_" + self.set
	self.targetname = local.spawnname
	self ai_off
	self hide
	self notsolid


	end


