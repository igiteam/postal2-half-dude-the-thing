// --------------------------------------------------------------------------------
// aispawn.scr
//
//	
//	Before level waittill prespawn "exec global/aispawn.scr".
//	
//	Place an enemy, give him targetname "aispawner". If you want him to charge at the player at spawn, set his #playerseek to 1. 
//
//	You can make him run to a specific destination by having him target the node you want him to run to.
//
//	You can create a trigger_multiple with targetname "aispawnertrigger" to set off the spawning. Give it the same #set value
//	as whichever spawners you want it to set off. Or you can do "thread global/aispawn.scr::spawn #" where # is the #set value you
//	want to set off.
//
//	You can do "thread global/aispawn.scr::spawngroup #1 #2" where #1 is the #set value you want to set off and #group is the group
//	value you want to set off.
//
//	You can set off spawners multiple times, but each trigger only can set them off once.
//	
//
//
// --------------------------------------------------------------------------------
level waittill prespawn		// make sure we're at least at the prespawn time when we do this

	// dprintlnln "****** INITIALIZING SPAWN TRIGGERS"
	waitthread InitializeSpawnTriggers
	waitthread InitializeSpawners
//	waitthread InitializeSpawners_New
//	waitthread InitializeSpawners_New2

	// Initialize the fauna manager
	//exec global/faunaspawn.scr

level waittill spawn


	thread axiscounter_init

end


//-----------------------------------------------------------
spawnset local.set local.enemyname local.get_there local.run_to_target local.use_difficulty local.delay_between_spawn:
//
//	Simplified "spawn" command.  (Most commonly used parameters to spawn)
//
// NOTE: If you use delay_between_spawn, you must:
//	1.) Call thread, NOT waitthread on spawnset
//	    (unless you are spawning in an independant thread)
//	2.) Realize that you should not run anything that is
//	    supposed to run on the guys you spawn until AFTER the spawn completes
//      Recommended delay = 0.1
//	This only needs to be used on prohibitively large spawnsets
//-----------------------------------------------------------

//	setcvar g_scripttrace 1

	if ( local.get_there==NIL )
		local.get_there = 0
	if ( local.use_difficulty==NIL )
		local.use_difficulty = 0

	waitthread spawn local.set NIL NIL NIL NIL local.enemyname local.get_there local.run_to_target local.use_difficulty NIL local.delay_between_spawn

//	setcvar g_scripttrace 0

end


//-----------------------------------------------------------
spawnset_convertactorname local.set:
//
//	ADDED:	by Benson Russell 4-19-2004
//	Simplified "spawn" command.  (Most commonly used parameters to spawn)
//	Special version that tells the spawner to convert targetnames to actornames upon spawn
//-----------------------------------------------------------

	//--- call the spawn command with the extra parameter for use_actorname
	waitthread spawn local.set NIL NIL NIL NIL NIL NIL NIL NIL 1

end


//-----------------------------------------------------------
spawngroup local.set local.group local.enemyname local.use_difficulty:
// 
//	use this when specifying groups to spawn...
//-----------------------------------------------------------
	if ( local.use_difficulty == NIL )
		local.use_difficulty = 0
	waitthread spawn local.set NIL NIL NIL local.group local.enemyname 0 1 local.use_difficulty
end

//-----------------------------------------------------------
spawn local.set local.pause local.thread local.off local.group local.enemyname local.get_there local.run_to_target local.use_difficulty local.use_actorname local.delay_between_spawn:
//
//	Does the actual spawn...
//
//	ADDED:	by Benson Russell 4-19-2004
//			added extra flag local.use_targetname to tell the spawner to convert the actorname to targetname upon spawn
//-----------------------------------------------------------

	if ( local.get_there==NIL )
		local.get_there = 0

	if ( local.run_to_target==NIL )
		local.run_to_target = 0
		
	if ( local.use_difficulty==NIL )
		local.use_difficulty = 0
		
	if ( local.delay_between_spawn == NIL )
		local.delay_between_spawn = 0

	if ( local.use_actorname==NIL )
		local.use_actorname = 0

//	if (getcvar(debug) == "1")
	println "aispawn.scr spawned set#" local.set " enemyname:" local.enemyname " use_actorname:" local.use_actorname

	if (local.pause != NIL)
		wait local.pause

	local.nSpawned = 0

	if (NIL == level.nPossiblySpawned)
		level.nPossiblySpawned = 0

	local.spawnname = "aispawner_" + local.set

	println "Spawnset:" local.set " has " $(local.spawnname).size " normal spawners."

	if ( $(local.spawnname).size>0 )
	{
		$(local.spawnname) waitthread SpawnNormal local.thread local.enemyname local.use_actorname local.delay_between_spawn local.get_there local.run_to_target
	}

	local.spawnname = "fastspawner_" + local.set

	println "Spawnset:" local.set " has " $(local.spawnname).size " FAST spawners."

	if ( $(local.spawnname).size>0 )
	{
		$(local.spawnname) waitthread SpawnFast local.thread local.enemyname local.use_actorname local.delay_between_spawn local.get_there local.run_to_target
	}

	end

//-----------------------------------------------------------
SpawnNormal local.thread local.enemyname local.use_actorname local.delay_between_spawn local.get_there local.run_to_target:
//-----------------------------------------------------------

	if ( (local.use_difficulty == 1) && ( getcvar(skill) == "0" ))
	{		
		level.nPossiblySpawned++
		
		// One out of three don't spawn in easy mode
		if ((level.nPossiblySpawned % 3) == 0)
		{
			//dprintln "Skipping a spawn " level.nPossiblySpawned
			end
		}
	}

	// spawn him in!
	local.ent = waitthread global/spawner.scr::spawner_activate self
	local.ent waitthread PostSpawn local.thread local.enemyname local.use_actorname local.get_there local.run_to_target

	if ( local.delay_between_spawn )
	{
		//dprintln "Waiting " local.delay_between_spawn
		wait local.delay_between_spawn
	}

end

//-----------------------------------------------------------
SpawnFast local.thread local.enemyname local.use_actorname local.delay_between_spawn local.get_there local.run_to_target:
//-----------------------------------------------------------

	println "SpawnFAST ENEMYNAME:" local.enemyname

	if ( (local.use_difficulty == 1) && ( getcvar(skill) == "0" ))
	{		
		level.nPossiblySpawned++
		
		// One out of three don't spawn in easy mode
		if ((level.nPossiblySpawned % 3) == 0)
		{
			//dprintln "Skipping a spawn " level.nPossiblySpawned
			self delete
			end
		}
	}

	self waitthread SpawnYourselfFast local.enemyname
	self waitthread PostSpawn local.thread local.enemyname local.use_actorname local.get_there local.run_to_target

	if ( local.delay_between_spawn )
	{
		//dprintln "Waiting " local.delay_between_spawn
		wait local.delay_between_spawn
	}

end

//-----------------------------------------------------------
PostSpawn local.thread local.enemyname local.use_actorname local.get_there local.run_to_target:
//-----------------------------------------------------------

	println "POSTSPAWN ENEMYNAME:" local.enemyname " use actorname:" local.use_actorname " self.actorname=" self.actorname

	if ( tolower( self.team ) != "american" )
	{
		self thread axiscounter_register
	}
	
	if (self.enemyname != -1)
	{
		// println "Assigning targetname:" self.enemyname
		self.targetname = self.enemyname
		println "spawned with map forced enemyname: " self.enemyname
	}
	else
	{
		if ( local.enemyname!=NIL )
		{
			self.targetname	= local.enemyname
			println "spawned with enemyname: " local.enemyname
		}
	}

	//--- ADDED by Benson Russell 4-19-2004
	//--- if use_actorname is set, convert it to the targetname
	if (local.use_actorname == 1 )
	{
		if( self.actorname != NIL && self.actorname != "" )
		{
			self.targetname = self.actorname
		}
	}
	
	if (level.active_think==1)
	{
		self ambush
//				dprintln "Spawned Ambush Guy"
	}
	else
	{
//				dprintln "Spawned Regular Guy"
	}

//jsl-->Not using?	if ($(local.spawnname)[local.i].fnum != NIL)
//		level.aifnum[$(local.spawnname)[local.i].fnum] = local.ent

//	local.ent.origin = self.origin
	self.creator = self
	
	if ((level.dontdropweapons != NIL) && (level.dontdropweapons == 1))
		self dontdropweapons

	self forceactivate
	//local.ent thread aispawned local.off local.get_there local.run_to_target
	self waitthread InitSpawnedAI

	if (self.thread != NIL)
		self thread level.script::self.thread

	if (local.thread != NIL)
		self thread level.script::local.thread

	if ( local.run_to_target && self.target )
	{
		if ( local.get_there )
		{
			println "AI Spawner running and shooting to target."
			self runandshoot self.target
		}
		else
		{
			println "AI Spawner running (no shoot) to target."
			self runto self.target
		}
	}

end


// --------------------------------------------------------------------------------
//	NOTE: do NOT call any of these threads externally.  They are to be used by the
//	threads in this script file only!  
// --------------------------------------------------------------------------------


//-----------------------------------------------------------
InitSpawnedAI:
//-----------------------------------------------------------
	if ( self.ammo_grenade==0 )
	{
		// make sure AI have grenades.
		if ( level.team=="american" )
		{
			println "Giving allied guy grenades:" level.alliedGrenadeCount
			self ammo_grenade level.alliedGrenadeCount
		}
		else
		{
			println "Giving axis guy grenades:" level.alliedGrenadeCount
			self ammo_grenade level.axisGrenadeCount
		}
	}

end

