//=============================================================
// Init - initializes variables for the SayManager
Init:
	if ( (self.saying == NIL) || (self.saying == NULL) )
	{
		self.saying = 0
		self.sayimportance = 0
		self.silent = 1
		
		self.chattertimer = 0
	}
end

//=============================================================
// SayManager - keeps track of what I'm trying to say and what is more important
// Importance is on a scale of 1 to 10 by convention (ie, it's not enforced)
SayManager local.sayanimation local.sayimportance local.postfix:

//		dprintln "SAYING: " local.sayanimation " ??????????"

	if (local.sayimportance == NIL || local.sayimportance == NULL || local.sayimportance == 0)
	{	
		local.sayimportance = 1
	}

	if ( self.sayimportance==NIL )
		self.sayimportance = -1
	
	if (local.postfix == NIL)
	{
		local.postfix = NULL
	}
	
	self attackchatter

	// check if I'm in the waiting state or if the new line is important enough to interrupt
	if ( (self.silent == 1) && ( self.saying == 0 || local.sayimportance > self.sayimportance )		 )
	{	
		self.silent = 0
		
		// Leave the waiting state
		self.saying = 1
		self.sayimportance = local.sayimportance
		if ( (self.saymanager != NIL) && (self.saymanager != NULL) )
		{
			self.saymanager end
		}
		self.saymanager = local

		// Say the line
		self.currentline = local.sayanimation

//		dprintln "SAYING: " local.sayanimation
		
		if (local.postfix != NULL)
		{
			//self setsay2 local.sayanimation local.postfix
		}
		else
		{
			//self setsay local.sayanimation
		}

		// Wait until we finish saying this line
		//self waittill saydone
		
//		dprintln "All done with saying "self.currentline		
		wait 4
		
		// Return to the waiting state
		if ( isAlive self )
		{
			self.silent = 1
			self.saying = 0
		}
	}
	else
	{
		//thread anim/attack.scr::DPrintln "   Say failed (old animation had importance of " self.sayimportance ")"
//		dprintln "Say failed " local.sayimportance " " self.sayimportance " (" self.currentline ")  silent=" self.silent
		waitframe
	}
end

