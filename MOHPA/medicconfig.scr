	level.MEDIC_EXPERIENCE_LEVEL = 0

end


// -----------------------------------------------------
MedConfig_Default:
//
// -----------------------------------------------------

	println "~~~~~~~~~~ Using default medic config for : " local.script

	waitthread SetMaxPlayerHeals 5 4 2 1
	level.MEDIC_EXPERIENCE_LEVEL = 0

end


// -----------------------------------------------------
SetMaxPlayerHeals local.d0 local.d1 local.d2 local.d3:
//
// Set # of Player heals based on the difficulty
// Number passed is for highest difficulty and actual number set
//	is scaled up on easier difficulty
// -----------------------------------------------------

	local.skill = int( getcvar skill )
	switch ( local.skill )
	{
	case 0:
		level.MEDIC_MAX_PLAYER_HEALS = local.d0
		break
	case 1:
		level.MEDIC_MAX_PLAYER_HEALS = local.d1
		break
	case 2:
		level.MEDIC_MAX_PLAYER_HEALS = local.d2
		break
	default:
		level.MEDIC_MAX_PLAYER_HEALS = local.d3
		break
	}

end

