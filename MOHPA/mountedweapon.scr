// -----------------------------------------------------------------------
ReloaderMount:
// Prefix_<mountedweapontype>_reloader_mount_<guninhand>
// -----------------------------------------------------------------------
	self.painhandler = anim/mountedweapon.scr::ReloaderPain
	self.painanimmode = direct_attached
	
	// get stance from turret
	if ((self.turret != NIL) && (self.turret != NULL))
	{
		self.position = self.turret.usestance
	}
	else
	{
		self.position = stand
	}

	local.anim = waitthread GetPrefix
	local.anim += waitthread GetWeaponTypeSuffix
	local.anim += "_reloader_mount"
	local.anim += waitthread GetGunInHandSuffix

	self setmotionanim local.anim
	self waittill flaggedanimdone

	end

// -----------------------------------------------------------------------
ReloaderDismount:
// Prefix_<mountedweapontype>_reloader_mount_<guninhand>
// -----------------------------------------------------------------------
	waitexec anim/default_inithandler.scr

	local.anim = waitthread GetPrefix
	local.anim += waitthread GetWeaponTypeSuffix
	local.anim += "_reloader_dismount"
	local.anim += waitthread GetHadGunSuffix

	self setmotionanim local.anim
	self waittill flaggedanimdone

	self.position = stand	// make sure the guy is in a stand position after dismounting
	end
