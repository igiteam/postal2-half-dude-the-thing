//----------------------------------------------------------------------------
//	order.scr
//
//	This script implements giving hand-signals or verbal orders (using animation)
//
//----------------------------------------------------------------------------
main:

end

//----------------------------------------------------------------------------
OrderInit:
//----------------------------------------------------------------------------

	self endactionanim

	switch ( self.position )
	{
		case	prone:
		case	pronewalk:
			self waitexec anim/crouch.scr::transition
			break;
	}

end




//----------------------------------------------------------------------------
order_ambush:
// aka "take cover"
//----------------------------------------------------------------------------
	self waitthread OrderInit

	dprintln "Unimplemented order. You should never see this message. Please bug it."

//	if ( self.team=="american" )
//		self thread global/hand_signals.scr::SetHandSignal "cover" 4 1 1

	self setmotionanim (self getalias signal cover)
	self waittill flaggedanimdone

end



//----------------------------------------------------------------------------
order_flankX2:
//----------------------------------------------------------------------------
	
	//self thread anim/SayManager.scr::SayManager DBLENV 8
	self waitthread order_flankleft	

	end

end



//----------------------------------------------------------------------------
order_flankleft:
//----------------------------------------------------------------------------

	self waitthread OrderInit	

//	if ( self.team=="american" )
//		self thread global/hand_signals.scr::SetHandSignal "flankleft" 4 1 1

	self setmotionanim (self getalias signal flankleft)
	self waittill flaggedanimdone

