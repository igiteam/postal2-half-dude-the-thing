//----------------------------------------------------------------------------
order_retreat:
//----------------------------------------------------------------------------	

	self waitthread OrderInit	

//	if ( self.team=="american" )
//		self thread global/hand_signals.scr::SetHandSignal "fallback" 4 1 1

	dprintln "order.scr: TODO: waiting for retreat animation"
	self setmotionanim (self getalias signal freeze)
	self waittill flaggedanimdone
	
end



