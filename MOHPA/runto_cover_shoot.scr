// ----------------------------------------------------------------------------
//	runto_cover_shoot.scr
//
//	Run to cover while firing at enemy (if facing him)
//
// ----------------------------------------------------------------------------
start:
	//Println "Running runto_cover.scr with move dir" self.movedir
	
	waitexec anim/default_inithandler.scr
	waitexec anim/smoking.scr::SmokeRemoveCigarette
	self weaponcommand mainhand attachtohand mainhand



	self.mood = alert
	group.debug = 0

	/*

	thread PlayRunAnimation
	group.runAnimationThread = parm.previousthread

//	self weaponcommand mainhand attachtohand mainhand

	waitthread ShootAtEnemy
	*/

	// jsl->Above way would be leaking threads I believe...

	// This should give desired results:

	self waitexec anim/stand.scr::transition	// transition to standing if needed

	// start up motion blend with shootwhilemoving at 101%
	self waitexec anim/motionblend.scr::Start run 1 101

	end



// ----------------------------------------------------------------------------
PlayRunAnimation:
// PlayRunAnimation calls a standard running script with a waitexec.  It's done from a seperate thread like this to 
// keep all threads in the same threadgroup, so that they will all end together if the group is terminated.
// ----------------------------------------------------------------------------

//	waitexec anim/runto_inopen.scr

	switch (self.position)
	{
		prone:
		pronewalk:
			waitexec anim/crouch.scr::transition
			// Deliberately fall through to crouched running now that we're crouched.
		crouch:
		crouchwalk:
		crouchrun:
			if (self.forceReload == 1)
			{
				waitexec anim/stand.scr::transition
			}
			else
			{
				self.position = crouchrun
				thread CrouchRunThread
				local.crouchthread = parm.previousthread
				local.crouchthread end
			}
			break
	}

	self.position = run
//jsl-->	waitexec anim/motionblend.scr::Start (self.weapongroup + "_run_") 0 0
	waitexec anim/motionblend.scr::Start run 0 0



end

// ----------------------------------------------------------------------------
ShootAtEnemy:
// ----------------------------------------------------------------------------

	while (1)
	{

		local.ang = self.angletoenemy
		if ( self.enemy )
		{
			local.canshoot = self canshoot self.enemy
		}
		else
		{
			local.canshoot = 1
		}

		// only shoot if our angle to the enemy isn't too far off...	
		if ( local.ang < 15 && local.canshoot != 0 )
		{
			self.shootinmotionanimdone = 0
			waitexec anim/shoot.scr::Shoot run
//			self waittill upperanimdone

			self.shootinmotionanimdone = 1
			waitexec anim/aim.scr::Aim run
//			self waittill upperanimdone
			self waittill flaggedanimdone
//			waitframe
		}
		else
		{

			self.shootinmotionanimdone = 1
			waitexec anim/aim.scr::Aim run
			// self waittill upperanimdone
			self waittill flaggedanimdone
		}
	}


	end

//===============
// CrouchRunThread
CrouchRunThread:

	waitexec anim/motionblend.scr::Start run 1 self.shootpct
//jsl-->	waitexec anim/motionblend.scr::Start (self.weapongroup + "_crouchrun_") 1 self.shootpct
	println "runto_cover_shoot.scr: AAAARGH! crouchrun thread ended! BUGBUGBUG!"
end

// ----------------------------------------------------------------------------
// thread DPrintln - for debug prints
DPrintln local.text1 local.text2 local.text3 local.text4 local.text5:
	thread DPrintorPrintln 1 local.text1 local.text2 local.text3 local.text4 local.text5
end

DPrint local.text1 local.text2 local.text3 local.text4 local.text5:
	thread DPrintorPrintln 0 local.text1 local.text2 local.text3 local.text4 local.text5
end

DPrintorPrintln local.newline local.text1 local.text2 local.text3 local.text4 local.text5:
	if (group.debug == 1)
	{
		if (local.text1 != NIL)
		{
			print local.text1
			if (local.text2 != NIL)
			{
				print local.text2
				if (local.text3 != NIL)
				{
					print local.text3
					if (local.text4 != NIL)
					{
						print local.text4
						if (local.text5 != NIL)
						{
							print local.text5
						}
					}
				}
			}
		}
		if (local.newline == 1)
		{
			println
		}
	}
end
