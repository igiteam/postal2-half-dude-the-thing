		thread randomsound ( 2993 -629 37.40 ) barricade_multi_metal 3 9
	}
	else if(local.script == "maps/7_1_tarawa_b_chunk2.scr" )  
	{
		thread sound ( 6122.28 -4722.57 116.23 ) tarawa_fire
		thread sound ( 8601.92 -6930.83 116.38 ) tarawa_fire
	}
	else if(local.script == "maps/7_1_tarawa_b_chunk1.scr" ) 
 	{

		thread sound ( -4095.88 2401.47 227.92 ) tank_hiss_ping
	}
	else
	{
		println "ambience.scr ERROR: level.script not processed (make sure this script name is all lower case): " local.script
	}

end



//================================================================================
// Local function to Play the Sound
sound local.origin local.sound:

	local.soundorigin = spawn script_model model "fx/dummy.tik"
	local.soundorigin svflags "+broadcast"

	local.soundorigin.origin = local.origin	
	local.soundorigin loopsound local.sound
	local.soundorigin notsolid

end local.soundorigin



//================================================================================
// Local function to play random sounds
randomsound local.sndPos local.sndalias local.sndMinWait local.sndMaxWait:
	
	local.sndEntity = spawn Entity
	local.sndEntity.origin = local.sndPos
	local.sndEntity notsolid

	while( 1 )
	{
		local.wait = randomfloat( local.sndMaxWait - local.sndMinWait ) + local.sndMinWait
		wait local.wait		
		local.sndEntity playsound local.sndalias
	}
end


