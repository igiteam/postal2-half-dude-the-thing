//----------------------------------------------------------------------------

// for support of fly-throughs in single player mode
	thread setupSPEffects


//-------------------------
setupSPEffects:
//-------------------------

	// this is just here so that when the artists run the fly through
	//    of the map, they get the right effect settings
	

	level waittill prespawn
	level waittill spawn

	local.gameType = getcvar("g_gametype")	
	if (local.gameType != "0")
		end
	
	$player global_posteffect 7	
	local.sat = getcvar(dm_def_cc_sat)
	local.add = getcvar(dm_def_cc_add)
	local.mul = getcvar(dm_def_cc_mul)
	local.blur = getcvar(dm_def_mono_blur)

	setcvar r_cc_sat local.sat
	setcvar r_cc_add local.add
	setcvar r_cc_mul local.mul
	setcvar r_mono_blur local.blue
	waitframe
end

//-------------------------
commitPostFx:
//-------------------------

while (1)
{
	dm_postfx_commit
	wait 0.5
}