end


// ------------------------------------------------------------------------------------
TurnAnimated:
// ------------------------------------------------------------------------------------
	self waitthread DecideGetup

	local.mood = self waitthread GetMood

	self setmotionanim (self getalias turn "" "" "" local.mood)
	self waittill flaggedanimdone

end

// ------------------------------------------------------------------------------------
GetMood:
// ------------------------------------------------------------------------------------

	if ( self.forcefacemotion && self.weapongroup==pistol )
	{
		if ( self.mood=="alert" )
		{
			end "cautious"
		}
	}

	switch ( self.mood )
	{
	case	alert:
	case	cautious:
		end self.mood
	default:
		end "ease"
	}

	end self.mood

// ------------------------------------------------------------------------------------
DecideGetup:
// ------------------------------------------------------------------------------------

	switch ( self.position )
	{
	case	prone:
	case	pronewalk:
		break
	default:
		end
	}

	waitexec anim/cover.scr::GetCoverSet

	// don't stand up if we're on a prone covernode.
	if ( self.cover_set==prone )
		end

	// go ahead and stand up before performing our turn animation.
	self waitthread anim/crouch.scr::transition

	end
