									self setmotionanim death_collapse
								}
								}	
								*/	
					self setmotionanim xxsxx_death_leftleg
							
		break
		//SC for now, since we don't really have these two values flushed out, just play some animation
	case "general":
	case "none":
	default:
//println "Warning: Fatal Shot in unknown body part!  (Part " self.hitlocation ")"
		self setmotionanim xxxxx_death_random
		break
	}

	end

