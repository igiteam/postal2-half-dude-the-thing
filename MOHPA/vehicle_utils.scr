PopulateAlliedJeep local.entVehicle local.strDriverHag local.strFrontRiderHag local.intGunnerRiders local.strGunnerRidersHag:
//
//	Takes an existing vehicle and populates it with driver and passengers.
//	All these passed in values can be set on the vehicle entity as well (see below).
//	To use the values set on the vehicle entity, pass a "" value into the
//	optional parameters.
//	All passed in values will override the set values on the entity.
//
//	There are default hag files that will be used if none are specified in the parameter
//	or on the vehicle entity.  So if you pass in a "" value for a hag file parameter,
//	and no hag file value was put on the vehicle entity, then the defaults will be used.
//
//	To not have any of the optional parameters take effect, pass a NIL value into each
//	parameter that is not desired.
//
//	local.entVehicle			= REQUIRED - entity, the vehicle to be populated.
//	local.strDriverHag			= OPTIONAL - string, the hag file for the driver.  Pass NIL for no driver
//	local.strFrontRiderHag		= OPTIONAL - string, the hag file for the front passenger slot.  Pass NIL for no front passenger
//	local.intGunnerRiders		= OPTIONAL - integer, the number of gunner riders to spawn.  Pass NIL or 0 for no gunners
//	local.strGunnerRidersHag	= OPTIONAL - string, the hag for the gunners
//
//	Values can also be set on the vehicle entity directly instead of passed.  Just pass
//	in a "" value into the parameter for each value you want taken from the
//	vehicle entity.  Passed in values will override the values on the entity:
//	
//	$modelDriver			- hag file for the driver
//	$modelFrontPassenger	- hag file for the front passenger
//	$modelGunner			- hag file for the gunner(s)
//	#numGunner				- number of back gunner(s)
//	NOT WORKING - $threadOnDriverDeath	- script thread to run when an associated driver is killed
//	NOT WORKING - $threadOnVehicleDeath	- script thread to run when an associated driver is killed
//
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: populate allied jeep: The vehicle entity that was passed in is invalid" )

	//--- set the default rider hags for this vehicle
	level.VEHICLE_UTILS_DEFAULT_DRIVER_HAG				= level.VEHICLE_UTILS_DEFAULT_ALLIED_DRIVER_HAG
	level.VEHICLE_UTILS_DEFAULT_FRONT_PASSENGER_HAG		= level.VEHICLE_UTILS_DEFAULT_ALLIED_FRONT_PASSENGER_HAG
	level.VEHICLE_UTILS_DEFAULT_GUNNER_HAG				= level.VEHICLE_UTILS_DEFAULT_ALLIED_GUNNER_HAG

	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- setup the vehicles slot counts
		waitthread SetupVehicle local.entVehicle[ local.i ]

		//--- if set, spawn and attach the driver
		waitthread GetAndSpawnDriver local.entVehicle[ local.i ] local.strDriverHag
	
		//--- if set, spawn and attach the front passenger
		waitthread GetAndSpawnFrontPassenger local.entVehicle[ local.i ] local.strFrontRiderHag
	
		//--- if set, spawn and attach the back passenger(s)
		waitthread GetAndSpawnGunner local.entVehicle[ local.i ] local.intGunnerRiders local.strGunnerRidersHag local.entVehicle[ local.i ].intNumGunnerSlots
	}

end




//===========================================================================================
//			AI EXIT FUNCTIONS
//===========================================================================================

// -----------------------------------------------------------------------------------
AIExit_All local.entVehicle:
//
//	tells the all the AI to get out of the passed in vehicle
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: AI exit all: A NULL vehicle was passed in for telling all riders to exit" )
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- call the individual exit functions, set to all
		thread AIExit_Driver	local.entVehicle
		thread AIExit_Front		local.entVehicle
		thread AIExit_Back		local.entVehicle
		thread AIExit_Gunner	local.entVehicle
	}	

end


// -----------------------------------------------------------------------------------
AIExit_Driver local.entVehicle:
//
//	tells the AI to get out of the driver seat of the passed in vehicle
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: AI exit driver: A NULL vehicle was passed in for telling drivers to exit" )
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- call the exit vehicle function: vehicle, numPassengersSlots, numGunnersSlots, numDriversSlots, [indexStart]
		thread AIExitVehicle local.entVehicle[ local.i ] 0 0 1
	}	

end


// -----------------------------------------------------------------------------------
AIExit_Front local.entVehicle:
//
//	tells the AI to get out of the front seat of the passed in vehicle
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: AI exit front: A NULL vehicle was passed in for telling riders to exit from the front" )
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- call the exit vehicle function: vehicle, numPassengersSlots, numGunnersSlots, numDriversSlots, [indexStart]
		thread AIExitVehicle local.entVehicle[ local.i ] 1 0 0
	}	

end


// -----------------------------------------------------------------------------------
AIExit_Back local.entVehicle local.intNumAIToExit:
//
//	tells the passed in number of AI to get out of the back seat/area of the passed in vehicle.
//	If either NIL or 0 (because why would you call this function with 0 people to get out),
//	it will make all of the back passengers get out of the vehicle.
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: AI exit back: A NULL vehicle was passed in for telling riders to exit from the back" )

	//--- if no number of AI to exit was passed, or zero, convet to mean exit all
	if( local.intNumAIToExit == NIL || local.intNumAIToExit == 0 )
	{
		local.intNumAIToExit = -1
	}

	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- call the exit vehicle function: vehicle, numPassengersSlots, numGunnersSlots, numDriversSlots, [indexStart]
		thread AIExitVehicle local.entVehicle[ local.i ] local.intNumAIToExit 0 0 1
	}

end


// -----------------------------------------------------------------------------------
AIExit_Gunner local.entVehicle local.intNumAIToExit:
//
//	tells the AI to get out of the gunner seats of the passed in vehicle
//	If either NIL or 0 (because why would you call this function with 0 people to get out),
//	it will make all of the gunner passengers get out of the vehicle.
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle[ 1 ] != NULL && "VEHICLE UTILS: AI exit gunner: A NULL vehicle was passed in for telling riders to exit from the front" )

	//--- if no number of AI to exit was passed, or zero, convet to mean exit all
	if( local.intNumAIToExit == NIL || local.intNumAIToExit == 0 )
	{
		local.intNumAIToExit = -1
	}
		
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		//--- call the exit vehicle function: vehicle, numPassengersSlots, numGunnersSlots, numDriversSlots, [indexStart]
		thread AIExitVehicle local.entVehicle[ local.i ] 0 local.intNumAIToExit 0
	}	

end


//===========================================================================================
//			AI ENTER FUNCTIONS - THESE CAN NOT BE CALLED ON ARRAY'S OF VEHICLES!!!
//===========================================================================================

// -----------------------------------------------------------------------------------
AIEnter_All local.entAI local.entVehicle local.boolGoDriver local.boolGoFrontPassenger local.boolGoBackPassenger local.boolGoGunner:
//
//	This will tell an AI, or an array of AI to enter a vehicle in the specified way.  There are 4
//	flags for driver, front passenger, back passenger, and gunner.  The flags tell whether or not
//	an AI will go to those positions.  The order in which AI will get on vehicles is:
//
//	driver, front passenger, back passenger, gunner
//
//	If NIL is passed, everything defaults to on.  Pass a 0 to not allow that position
// -----------------------------------------------------------------------------------

	assert( local.entAI[ 1 ] != NULL && "VEHICLE UTILS: AI enter all: The passed in AI was invalid" )
	assert( local.entVehicle != NULL && "VEHICLE UTILS: AI enter all: The passed in vehicle to have all AI enter on was invalid" )
	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: AI enter all: The passed in vehicle to have all AI enter on was an array larger than 1" )

	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entAI.size ; local.i++ )
	{
		local.boolBackPassengerSuccess	= 0
		local.boolGunnerSuccess			= 0
		
		//--- first the driver
		if( local.boolGoDriver != 0 )
		{
			//--- check the slot
			local.entTestSlot = waitthread GetVehicleSlotEntity local.entVehicle "driver" 0
			
			//dprintln "GOING FOR DRIVER, STATUS: " local.entTestSlot " - sending index: " local.i
			
			//--- if the slot was full, skip this section
			if( local.entTestSlot == NULL )
			{
				thread AIEnter_Driver local.entAI[ local.i ] local.entVehicle
				wait .5
			}
			
			//--- after checking set the flag for no more of this class
			local.boolGoDriver = 0
			continue
		}

		//--- second the front passenger
		if( local.boolGoFrontPassenger != 0 )
		{
			//--- check the slot
			local.entTestSlot = waitthread GetVehicleSlotEntity local.entVehicle "passenger" 0
			
			//dprintln "GOING FOR FRONT, STATUS: " local.entTestSlot " - sending index: " local.i
			
			//--- if the slot was full, skip this section
			if( local.entTestSlot == NULL )
			{
				thread AIEnter_Front local.entAI[ local.i ] local.entVehicle
				wait .5
			}
			
			//--- after checking set the flag for no more of this class
			local.boolGoFrontPassenger = 0
			continue
		}

		//--- third the back passengers
		if( local.boolGoBackPassenger != 0 )
		{
			//dprintln "GOING FOR BACK ON INDEX: " local.i
			
			//--- check the slot
			local.boolBackPassengerSuccess = waitthread AIEnter_Back local.entAI[ local.i ] local.entVehicle
			
			//dprintln "GOING FOR BACK STATUS: " local.boolBackPassengerSuccess " - sending index: " local.i
			
			//--- if the return value is NIL, then the AI couldn't get to a slot
			if( local.boolBackPassengerSuccess == NIL )
			{
				//--- there are no more free back passengers, so bug out of this part of the loop
				local.boolGoBackPassenger = 0
			}
			
			continue
		}
		
		//--- fourth the gunner passengers
		if( local.boolGoGunner != 0 )
		{
			//dprintln "GOING FOR GUNNER ON INDEX: " local.i
			
			//--- check the slot
			local.boolGunnerSuccess = waitthread AIEnter_Gunner local.entAI[ local.i ] local.entVehicle
			
			//dprintln "GOING FOR GUNNER STATUS: " local.boolGunnerSuccess " - sending index: " local.i
			
			//--- if the return value is NIL, then the AI couldn't get to a slot
			if( local.boolGunnerSuccess == NIL )
			{
				//--- there are no more free back passengers, so bug out of this part of the loop
				local.boolGoGunner = 0
			}
			
			continue
		}
	}

end


// -----------------------------------------------------------------------------------
AIEnter_Driver local.entAI local.entVehicle:
//
//	tells the AI to enter the drivers seat of the passed in vehicle
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entAI = waitthread SetupSelf self local.entAI
	
	assert( local.entVehicle != NULL && "VEHICLE UTILS: AI enter driver: The passed in vehicle to have a driver enter on was invalid" )
	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: AI enter driver: The passed in vehicle to have a driver enter on was an array larger than 1" )
	
	local.intSuccess = NIL
	
	//--- call the enter vehicle function: AI, vehicle, goPassenger, goGunner, goDriver, [indexStart], [indexLimit], [boolLockVehicle]
	local.intSuccess = waitthread AIEnterVehicle local.entAI local.entVehicle 0 0 1 NIL NIL 0

end local.intSuccess


// -----------------------------------------------------------------------------------
AIEnter_Front local.entAI local.entVehicle:
//
//	tells the AI to enter the front seat of the passed in vehicle
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entAI = waitthread SetupSelf self local.entAI
	
	assert( local.entVehicle != NULL && "VEHICLE UTILS: AI enter front: The passed in vehicle to have a driver enter on was invalid" )
	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: AI enter front: The passed in vehicle to have a driver enter on was an array larger than 1" )
	
	local.intSuccess = NIL
	
	//--- call the enter vehicle function: AI, vehicle, goPassenger, goGunner, goDriver, [indexStart], [indexLimit], [boolLockVehicle]
	local.intSuccess = waitthread AIEnterVehicle local.entAI local.entVehicle 1 0 0 0 NIL 0

end local.intSuccess


// -----------------------------------------------------------------------------------
AIEnter_Back local.entAI local.entVehicle:
//
//	tells the AI to enter the back seat of the passed in vehicle
//	can accept an array of AI
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entAI = waitthread SetupSelf self local.entAI
	
	assert( local.entVehicle != NULL && "VEHICLE UTILS: AI enter back: The passed in vehicle to have a driver enter on was invalid" )
	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: AI enter back: The passed in vehicle to have a driver enter on was an array larger than 1" )

	local.intSuccess = NIL
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entAI.size ; local.i++ )
	{
		//--- call the enter vehicle function: AI, vehicle, goPassenger, goGunner, goDriver, [indexStart], [indexLimit], [boolLockVehicle]
		local.intSuccess = waitthread AIEnterVehicle local.entAI[ local.i ] local.entVehicle 1 0 0 NIL 1
	}

end local.intSuccess


// -----------------------------------------------------------------------------------
AIEnter_Gunner local.entAI local.entVehicle:
//
//	tells the AI to enter the gunner of the passed in vehicle
//	can accept an array of AI
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entAI = waitthread SetupSelf self local.entAI
	
	assert( local.entVehicle != NULL && "VEHICLE UTILS: AI enter gunner: The passed in vehicle to have a driver enter on was invalid" )
	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: AI enter gunner: The passed in vehicle to have a driver enter on was an array larger than 1" )
	
	local.intSuccess = NIL
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entAI.size ; local.i++ )
	{
		//--- call the enter vehicle function: AI, vehicle, goPassenger, goGunner, goDriver, [indexStart], [indexLimit], [boolLockVehicle]
		local.intSuccess = waitthread AIEnterVehicle local.entAI[ local.i ] local.entVehicle 0 1 0
	}

end local.intSuccess




//===========================================================================================
//			EXTERNAL GETTER FUNCTIONS
//===========================================================================================

//==============  GET AI COUNT ====================

// -----------------------------------------------------------------------------------
GetAICount_All local.entVehicle local.boolGoDriver local.boolGoFrontPassenger local.boolGoBackPassenger local.boolGoGunner:
//
//	Returns the total count of how many AI are in all the positions on the vehicle.
//	This can be tuned by passing in variables to say which rider classes to ignore.
//	Pass in a 0 to have that rider class not be checkd.  Default is to check all classes.
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI count all: The passed in vehicle was invalid" )

	local.intResult = 0
	
	//--- check the driver's position
	if( local.boolGoDriver != 0 )
	{
		local.intResult2 = waitthread GetAICount_Driver local.entVehicle
		local.intResult += local.intResult2
	}

	//--- check the front passenger's position
	if( local.boolGoFrontPassenger != 0 )
	{
		local.intResult2 = waitthread GetAICount_Front local.entVehicle
		local.intResult += local.intResult2
	}	

	//--- check the back passenger's position
	if( local.boolGoBackPassenger != 0 )
	{
		local.intResult2 = waitthread GetAICount_Back local.entVehicle
		local.intResult += local.intResult2
	}	

	//--- check the gunner's position
	if( local.boolGoGunner != 0 )
	{
		local.intResult2 = waitthread GetAICount_Gunner local.entVehicle
		local.intResult += local.intResult2
	}	
		
end local.intResult


// -----------------------------------------------------------------------------------
GetAICount_Driver local.entVehicle:
//
//	returns the count of how many drivers are on the vehicle.  This will pretty much
//	be either 1 or 0, but to be consistent with the other get count functions, it's the
//	same format.
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI count driver: The passed in vehicle was invalid" )
	
	local.intResult = 0
	
	//--- check the driver's position
	local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "driver" 0
	
	if( local.entTestResult != NULL )
	{
		local.intResult = 1
	}
	
end local.intResult


// -----------------------------------------------------------------------------------
GetAICount_Front local.entVehicle:
//
//	returns the count of how many front passengers are on the vehicle.  This will pretty much
//	be either 1 or 0, but to be consistent with the other get count functions, it's the
//	same format.
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI count front: The passed in vehicle was invalid" )
	
	local.intResult = 0
	
	//--- check the front passenger's position
	local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "passenger" 0
	
	if( local.entTestResult != NULL )
	{
		local.intResult = 1
	}
	
end local.intResult


// -----------------------------------------------------------------------------------
GetAICount_Back local.entVehicle:
//
//	returns the count of how many back passengers are on the vehicle.  Returns 0
//	if there are none
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI count back: The passed in vehicle was invalid" )
	
	local.intResult = 0
	
	//--- check the back passenger positions
	for( local.i = 1 ; local.i <= local.entVehicle.intNumPassengerSlots ; local.i++ )
	{
		local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "passenger" local.i
			
		if( local.entTestResult != NULL )
		{
			local.intResult++
		}
	}
		
end local.intResult


// -----------------------------------------------------------------------------------
GetAICount_Gunner local.entVehicle:
//
//	returns the count of how many gunners are on the vehicle.  Returns 0
//	if there are none
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI count gunner: The passed in vehicle was invalid" )
	
	local.intResult = 0
	local.intNumGunnerSlots = local.entVehicle.intNumGunnerSlots - 1
	
	//--- check the back passenger positions
	for( local.i = 0 ; local.i <= local.intNumGunnerSlots ; local.i++ )
	{
		local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "turret" local.i
			
		if( local.entTestResult != NULL )
		{
			local.intResult++
		}
	}
		
end local.intResult


//==============  GET AI ENTITY ====================

// -----------------------------------------------------------------------------------
GetAI_All local.entVehicle local.boolGoDriver local.boolGoFrontPassenger local.boolGoBackPassenger local.boolGoGunner:
//
//	Returns the all the AI entities on the vehicle.  This can be tuned by passing in
//	variables to say which rider classes to ignore.  Pass in a 0 to have that rider class
//	not be checkd.  Default is to check all classes.
//	This function returns an array of all the AI on the vehicle
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI All: The passed in vehicle was invalid" )
	assert( local.entVehicle.size == 1 &&  "VEHICLE UTILS: Get AI All: The passed in vehicle was an array larger than 1" )

	local.entFinalResult[ 1 ]	= NULL
	local.intFinalResultIndex	= 1
		
	//--- check the driver's position
	if( local.boolGoDriver != 0 )
	{
		local.entTestResult = waitthread GetAI_Driver local.entVehicle

		if( local.entTestResult != NULL )
		{
			local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult
			local.intFinalResultIndex++
		}
	}

	//--- check the front passenger's position
	if( local.boolGoFrontPassenger != 0 )
	{
		local.entTestResult = waitthread GetAI_Front local.entVehicle

		if( local.entTestResult != NULL )
		{
			local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult
			local.intFinalResultIndex++
		}
	}	

	//--- check the back passenger's position
	if( local.boolGoBackPassenger != 0 )
	{
		local.entTestResult = waitthread GetAI_Back local.entVehicle

		if( local.entTestResult[ 1 ] != NULL )
		{
			for( local.i = 1 ; local.i <= local.entTestResult.size ; local.i++ )
			{
				local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult[ local.i ]
				local.intFinalResultIndex++
			}
		}
	}	

	//--- check the gunner's position
	if( local.boolGoGunner != 0 )
	{
		local.entTestResult = waitthread GetAI_Gunner local.entVehicle

		if( local.entTestResult[ 1 ] != NULL )
		{
			for( local.i = 1 ; local.i <= local.entTestResult.size ; local.i++ )
			{
				local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult[ local.i ]
				local.intFinalResultIndex++
			}
		}
	}	
		
end local.entFinalResult


// -----------------------------------------------------------------------------------
GetAI_Driver local.entVehicle:
//
//	returns the driver entity on the vehicle.  Returns NULL if non existent, or the entity
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI Driver: The passed in vehicle was invalid" )
	assert( local.entVehicle.size == 1 &&  "VEHICLE UTILS: Get AI Drive: The passed in vehicle was an array larger than 1" )

	//--- grabe the enity on the desired slot
	local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "driver" 0
		
end local.entTestResult


// -----------------------------------------------------------------------------------
GetAI_Front local.entVehicle:
//
//	returns the front passenger entity on the vehicle.  Returns NULL if non existent, or the entity
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI Front: The passed in vehicle was invalid" )
	assert( local.entVehicle.size == 1 &&  "VEHICLE UTILS: Get AI Front: The passed in vehicle was an array larger than 1" )

	//--- grabe the enity on the desired slot
	local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "passenger" 0
		
end local.entTestResult


// -----------------------------------------------------------------------------------
GetAI_Back local.entVehicle:
//
//	returns the back passengers on the vehicle.  Returns NULL if non existent,
//	it will return an array of all the passengers.
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI Back: The passed in vehicle was invalid" )
	assert( local.entVehicle.size == 1 &&  "VEHICLE UTILS: Get AI Back: The passed in vehicle was an array larger than 1" )

	local.entFinalResult[ 1 ]	= NULL
	local.intFinalResultIndex	= 1

	//--- check the back passenger positions
	for( local.i = 1 ; local.i <= local.entVehicle.intNumPassengerSlots ; local.i++ )
	{
		local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "passenger" local.i
	
		//--- If there is an entity on the current slot, store it into the array and up the index
		if( local.entTestResult != NULL )
		{
			local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult
			local.intFinalResultIndex++
		}
	}
			
end local.entFinalResult


// -----------------------------------------------------------------------------------
GetAI_Gunner local.entVehicle:
//
//	returns the gunners on the vehicle.  Returns NULL if non existent,
//	it will return an array of all the passengers.
// -----------------------------------------------------------------------------------

	assert( local.entVehicle != NULL && "VEHICLE UTILS: Get AI Gunner: The passed in vehicle was invalid" )
	assert( local.entVehicle.size == 1 &&  "VEHICLE UTILS: Get AI Gunner: The passed in vehicle was an array larger than 1" )

	local.entFinalResult[ 1 ]	= NULL
	local.intFinalResultIndex	= 1

	local.intNumGunnerSlots = local.entVehicle.intNumGunnerSlots - 1
	
	//--- check the gunner positions
	for( local.i = 0 ; local.i <= local.intNumGunnerSlots ; local.i++ )
	{
		local.entTestResult = waitthread GetVehicleSlotEntity local.entVehicle "turret" local.i
	
		//--- If there is an entity on the current slot, store it into the array and up the index
		if( local.entTestResult != NULL )
		{
			local.entFinalResult[ local.intFinalResultIndex ] = local.entTestResult
			local.intFinalResultIndex++
		}
	}
			
end local.entFinalResult




//===========================================================================================
//			MISC FUNCTIONS
//===========================================================================================

// -----------------------------------------------------------------------------------
SetAutoTarget local.entVehicle local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and sets the turret(s) to have "auto" targeting type
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "SET AUTO TARGET: " local.entVehicle " - all turrets: " local.boolUseAllTurrets
	
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 1
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
SetManualTarget local.entVehicle local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and sets the turret(s) to have "none" targeting type for manual assignment
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "SET MANUAL TARGET: " local.entVehicle " - all turrets: " local.boolUseAllTurrets
	
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 2
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
ClearAimTarget local.entVehicle local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and clears the aim target
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "CLEAR AIM TARGET: " local.entVehicle " - all turrets: " local.boolUseAllTurrets
	
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 3
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
SetAimTarget local.entVehicle local.entTarget local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and sets the passed in target on the turret(s)
//	This function will set the turret(s) into manual target mode
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "SET AIM TARGET: " local.entVehicle " - target: " local.entTarget " - all turrets: " local.boolUseAllTurrets
	
	//--- set manual targeting mode on the turret(s)
	waitthread SetManualTarget local.entVehicle local.boolUseAllTurrets

	//--- do the turret operation
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 4 local.entTarget
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
ShootAt local.entVehicle local.entTarget local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and makes it shoot at the passed in target
//	can accept an array of vehicles.
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "SHOOT AT: " local.entVehicle " - target: " local.entTarget " - all turrets: " local.boolUseAllTurrets
	
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 5 local.entTarget
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
Shoot local.entVehicle local.boolUseAllTurrets:
//
//	Takes the passed in vehicle and shoots a burt from its turret(s)
//	THIS ONLY WORKS WITH VEHICLES THAT HAVE WEAPON TURRETS
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//dprintln "SHOOT: " local.entVehicle " - all turrets: " local.boolUseAllTurrets
	
	waitthread SetTurret local.entVehicle local.boolUseAllTurrets 0
	//--- operations to set on the turret
	//	0	- shoot
	//	1	- set targettype to auto
	//	2	- set targettype to none
	//	3	- clear aim target
	//	4	- set aim target to the passed in target
	//	5	- set enemy to the passed in target

end


// -----------------------------------------------------------------------------------
DrivePath local.entVehicle local.entPath local.intSpeed:
//
//	Takes the passed in vehicle and makes it drive the passed in path at the passed in speed.
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle

	assert( local.entVehicle.size == 1 && "VEHICLE UTILS: DrivePath: The passed in vehicle entity is an array greater than 1" )
	assert( local.entPath != NIL && "VEHICLE UTILS: DrivePath: A NIL path was passed in to be driven" )
	assert( local.entPath != NULL && "VEHICLE UTILS: DrivePath: The passed in path to drive was invalid" )
	
	//--- if the passed speed was not nil, pass it to the drive command
	if( local.intSpeed != NIL )
	{
		local.entVehicle drive local.entPath local.intSpeed
	}
	else
	{
		local.entVehicle drive local.entPath
	}
		
	local.entVehicle waittill drive

end


// -----------------------------------------------------------------------------------
WaitForVehicle local.entVehicle:
//
//	this is a stall thread that can be called.  It will hold until all the AI that have
//	been told to get on or off the vehicle have completed their actions, or the vehicle
//	is destroyed
//	can accept an array of vehicles
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entVehicle = waitthread SetupSelf self local.entVehicle
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entVehicle.size ; local.i++ )
	{
		while( local.entVehicle[ local.i ] != NULL && local.entVehicle[ local.i ].health > 0 && local.entVehicle[ local.i ].intWaitingForAI != 0 )
		{
			//dprintln "WAITING FOR ALL AI TO DO STUFF ON VEHILCE: " local.entVehicle " - Num AI: " local.entVehicle.intWaitingForAI
			wait .25
		}
	}
	
end




// ----------------------------------------------------------------------------------
FollowTheLeader local.entFollower local.entLeader:
//
//	tells a vehicle to follow a leader on the path
// ----------------------------------------------------------------------------------

	assert( local.entFollower != NULL && "The passed in follower is invalid" )
	assert( local.entLeader != NULL && "The passed in leader is invalid" )

	//--- set the leader
	local.entFollower.entLeader = local.entLeader.targetname

	while( (local.entFollower.health > 0) && (local.entFollower.entLeader != NIL) )
	{
		//--- check the distance, if we're too close, pause, else resume
		local.fltDistance = vector_length (local.entFollower.origin - local.entLeader.origin)
		
		//dprintln "FOLLOW DISTANCE CHECK: " local.fltDistance " - on follower: " local.entFollower " - leader: " local.entLeader
		
		if( local.fltDistance < level.VEHICLE_FOLLOW_THRESHOLD )
		{
			//dprintln "FOLLOW DISTANCE THRESHOLD BREACHED! PAUSING"
			local.entFollower pausedrive 1
		}
		else
		{
			//dprintln "FOLLOW DISTANCE RESUMING"
			wait 1
			local.entFollower pausedrive 0
		}
		
		//--- check if the leader was destroyed, if so, cycle to a new leader if available
		if( local.entLeader.health < 0 )
		{
			//--- see if there's another leader
			local.entNewLeader = waitthread VehicleThinker_Follow_FindNewLeader local.entLeader
			
			//--- if the returned new leader is null, then there are no more leaders to follow
			if( local.entNewLeader == NULL )
			{
				//--- set to nil to end this loop and make sure he's driving
				local.entFollower.entLeader = NIL
				local.entFollower pausedrive 0
			}
			else	//--- assign it as the new leader
			{
				local.entLeader = local.entNewLeader
			}
		}
		
		//--- think cycle time
		wait .2
	}

end


