//===========================================================================================
//			INIT FUNCTIONS
//===========================================================================================

// -----------------------------------------------------------------------------------
Init:
//
//	sets default values for the vehicle scripts
// -----------------------------------------------------------------------------------

	//--- init default axis character hags
	level.VEHICLE_UTILS_DEFAULT_AXIS_DRIVER_HAG				= "models/characters/axis/axis_marineinfantry.hag"
	level.VEHICLE_UTILS_DEFAULT_AXIS_FRONT_PASSENGER_HAG	= "models/characters/axis/axis_marineinfantry.hag"
	level.VEHICLE_UTILS_DEFAULT_AXIS_BACK_PASSENGER_HAG		= "models/characters/axis/axis_marineinfantry.hag"
	level.VEHICLE_UTILS_DEFAULT_AXIS_GUNNER_HAG				= "models/characters/axis/axis_marineinfantry.hag"
		
	//--- default allied character hags
	level.VEHICLE_UTILS_DEFAULT_ALLIED_DRIVER_HAG			= "models/characters/allied/allied_marinenormal1.hag"
	level.VEHICLE_UTILS_DEFAULT_ALLIED_FRONT_PASSENGER_HAG	= "models/characters/allied/allied_marinenormal3.hag"
	level.VEHICLE_UTILS_DEFAULT_ALLIED_BACK_PASSENGER_HAG	= "models/characters/allied/allied_marinenormal2.hag"
	level.VEHICLE_UTILS_DEFAULT_ALLIED_GUNNER_HAG			= "models/characters/allied/allied_marinenormal2.hag"
		
	//--- default riders counts
	level.VEHICLE_UTILS_DEFAULT_GUNNER_NUM					= 1
	level.VEHICLE_UTILS_DEFAULT_BACK_PASSENGER_NUM			= 2
	
	//--- init vehicle hags
	level.VEHICLE_UTILS_AXIS_TRUCK_HAG		= "models/vehicles/model_94.hag"
	level.VEHICLE_UTILS_AXIS_JEEP_HAG		= "models/vehicles/t_95scout.hag"
	level.VEHICLE_UTILS_AXIS_TANK_TYPE97	= "models/vehicles/type97_chiha.hag"
	level.VEHICLE_UTILS_AXIS_TANK_TYPE95	= "models/vehicles/type95_hago.hag"
	level.VEHICLE_UTILS_AXIS_TANK_TYPE87	= "models/vehicles/type87_lght_armor.hag"
	
	level.VEHICLE_UTILS_ALLIED_JEEP_HAG		= "models/vehicles/willys_jeep.hag"

	//--- init misc values
	level.VEHICLE_FOLLOW_THRESHOLD			= 400
	level.VEHICLE_UTILS_UNIQUE_ID			= 0

end


//===========================================================================================
//			VEHICLE SPAWN FUNCTIONS
//===========================================================================================

//===================  AXIS VEHICLES  ===============================

// -----------------------------------------------------------------------------------
SpawnAxisTruck local.entSpawnTarget local.strTargetname local.strDriverHag local.strFrontRiderHag local.intBackRiders local.strBackRidersHag local.bPlayStartSounds:
//
//	Spawn an axis truck with optional driver and riders
//	All these passed in values can be set on the spawntarget entity as well (see below).
//	To use the values set on the spawntarget entity, pass a "" value into the
//	optional parameters.  This will also work with the strTargetname value as well.
//	All passed in values will override the set values on the entity.
//
//	There are default hag files that will be used if none are specified in the parameter
//	or on the spawntarget entity.  So if you pass in a "" value for a hag file parameter,
//	and no hag file value was put on the spawntarget entity, then the defaults will be used.
//
//	To not have any of the optional parameters take effect, pass a NIL value into each
//	parameter that is not desired.
//
//	local.entSpawnTarget	= REQUIRED - entity, the object to spawn the vehicle at
//	local.strTargetname		= REQUIRED - string, the targetname to give the vehicle.
//	local.strDriverHag		= OPTIONAL - string, the hag file for the driver.  Pass NIL for no driver
//	local.strFrontRiderHag	= OPTIONAL - string, the hag file for the front passenger slot.  Pass NIL for no front passenger
//	local.intBackRiders		= OPTIONAL - integer, the number of back seat riders to spawn.  Pass NIL or 0 for no back passengers
//	local.strBackRidersHag	= OPTIONAL - string, the hag for the riders
//
//	Values can also be set on the spawntarget entity directly instead of passed.  Just pass
//	in a "" value into the parameter for each value you want taken from the
//	spawntarget entity.  Passed in values will override the values on the entity:
//	
//	$modelDriver			- hag file for the driver
//	$modelFrontPassenger	- hag file for the front passenger
//	$modelBackPassenger		- hag file for the back passenger(s)
//	#numBackPassenger		- number of back passenger(s)
//	$spawnTargetname		- targetname for the vehicle upon spawning
//	NOT WORKING - $threadOnDriverDeath	- script thread to run when an associated driver is killed
//	NOT WORKING - $threadOnVehicleDeath	- script thread to run when an associated driver is killed
//
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entSpawnTarget = waitthread SetupSelf self local.entSpawnTarget

	assert( local.entSpawnTarget[ 1 ] != NIL && local.entSpawnTarget[ 1 ] != NULL && "VEHICLE UTILS: Spawn axis truck: The spawn target entity that was passed in is invalid" )
	
	//--- set the default rider hags for this vehicle
	level.VEHICLE_UTILS_DEFAULT_DRIVER_HAG				= level.VEHICLE_UTILS_DEFAULT_AXIS_DRIVER_HAG
	level.VEHICLE_UTILS_DEFAULT_FRONT_PASSENGER_HAG		= level.VEHICLE_UTILS_DEFAULT_AXIS_FRONT_PASSENGER_HAG
	level.VEHICLE_UTILS_DEFAULT_BACK_PASSENGER_HAG		= level.VEHICLE_UTILS_DEFAULT_AXIS_BACK_PASSENGER_HAG
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entSpawnTarget.size ; local.i++ )
	{
		//--- spawn the vehicle
		local.entVehicle = waitthread SpawnVehicle level.VEHICLE_UTILS_AXIS_TRUCK_HAG local.entSpawnTarget[ local.i ] local.strTargetname local.bPlayStartSounds
	
		//--- setup the vehicles slot counts
		waitthread SetupVehicle local.entVehicle
	
		//--- if set, spawn and attach the driver
		waitthread GetAndSpawnDriver local.entVehicle local.strDriverHag
	
		//--- if set, spawn and attach the front passenger
		waitthread GetAndSpawnFrontPassenger local.entVehicle local.strFrontRiderHag
		
		//--- calculate the limit of back passengers
		local.intLimitBackPassengers = local.entVehicle.intNumPassengerSlots - 1
	
		//--- if set, spawn and attach the back passenger(s)
		waitthread GetAndSpawnBackPassenger local.entVehicle local.intBackRiders local.strBackRidersHag local.intLimitBackPassengers
	}

end local.entVehicle


// -----------------------------------------------------------------------------------
SpawnAxisJeep local.entSpawnTarget local.strTargetname local.strDriverHag local.strFrontRiderHag local.intBackRiders local.strBackRidersHag local.bPlayStartSounds:
//
//	Spawn an axis jeep with optional driver and riders
//	All these passed in values can be set on the spawntarget entity as well (see below).
//	To use the values set on the spawntarget entity, pass a "" value into the
//	optional parameters.  This will also work with the strTargetname value as well.
//	All passed in values will override the set values on the entity.
//
//	There are default hag files that will be used if none are specified in the parameter
//	or on the spawntarget entity.  So if you pass in a "" value for a hag file parameter,
//	and no hag file value was put on the spawntarget entity, then the defaults will be used.
//
//	To not have any of the optional parameters take effect, pass a NIL value into each
//	parameter that is not desired (you can spawn an empty vehicle if you want this way).
//
//	local.entSpawnTarget	= REQUIRED - entity, the object to spawn the vehicle at
//	local.strTargetname		= REQUIRED - string, the targetname to give the vehicle.
//	local.strDriverHag		= OPTIONAL - string, the hag file for the driver.  Pass NIL for no driver
//	local.strFrontRiderHag	= OPTIONAL - string, the hag file for the front passenger slot.  Pass NIL for no front passenger
//	local.intBackRiders		= OPTIONAL - integer, the number of back seat riders to spawn.  Pass NIL or 0 for no back passengers
//	local.strBackRidersHag	= OPTIONAL - string, the hag for the riders
//
//	Values can also be set on the spawntarget entity directly instead of passed.  Just pass
//	in a "" value into the parameter for each value you want taken from the
//	spawntarget entity.  Passed in values will override the values on the entity:
//	
//	$modelDriver			- hag file for the driver
//	$modelFrontPassenger	- hag file for the front passenger
//	$modelBackPassenger		- hag file for the back passenger(s)
//	#numBackPassenger		- number of back passenger(s)
//	$spawnTargetname		- targetname for the vehicle upon spawning
//	NOT WORKING - $threadOnDriverDeath	- script thread to run when an associated driver is killed
//	NOT WORKING - $threadOnVehicleDeath	- script thread to run when an associated driver is killed
//
// -----------------------------------------------------------------------------------

	//--- test to see if self was used, if so, override the passed in parameter
	local.entSpawnTarget = waitthread SetupSelf self local.entSpawnTarget

	assert( local.entSpawnTarget[ 1 ] != NIL && local.entSpawnTarget[ 1 ] != NULL && "VEHICLE UTILS: Spawn axis jeep: The spawn target entity that was passed in is invalid" )

	//--- set the default rider hags for this vehicle
	level.VEHICLE_UTILS_DEFAULT_DRIVER_HAG				= level.VEHICLE_UTILS_DEFAULT_AXIS_DRIVER_HAG
	level.VEHICLE_UTILS_DEFAULT_FRONT_PASSENGER_HAG		= level.VEHICLE_UTILS_DEFAULT_AXIS_FRONT_PASSENGER_HAG
	level.VEHICLE_UTILS_DEFAULT_BACK_PASSENGER_HAG		= level.VEHICLE_UTILS_DEFAULT_AXIS_BACK_PASSENGER_HAG
	
	//--- handle in case an array was passed in
	for( local.i = 1 ; local.i <= local.entSpawnTarget.size ; local.i++ )
	{	
		//--- spawn the vehicle
		local.entVehicle = waitthread SpawnVehicle level.VEHICLE_UTILS_AXIS_JEEP_HAG local.entSpawnTarget[ local.i ] local.strTargetname local.bPlayStartSounds
	
		//--- setup the vehicles slot counts
		waitthread SetupVehicle local.entVehicle
	
		//--- if set, spawn and attach the driver
		waitthread GetAndSpawnDriver local.entVehicle local.strDriverHag
	
		//--- if set, spawn and attach the front passenger
		waitthread GetAndSpawnFrontPassenger local.entVehicle local.strFrontRiderHag

		//--- calculate the limit of back passengers
		local.intLimitBackPassengers = local.entVehicle.intNumPassengerSlots - 1
			
		//--- if set, spawn and attach the back passenger(s)
		waitthread GetAndSpawnBackPassenger local.entVehicle local.intBackRiders local.strBackRidersHag local.intLimitBackPassengers
	}
	
end local.entVehicle


