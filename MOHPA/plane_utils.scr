// SPAWN PLANES
//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//----------------------------------------------------------------------------
SpawnPlaneVRP local.spawnPosition local.health local.deathanim local.stayInvulnerable local.dontProtect:
//
//	Spawns a Vehicle_Ridable_Plane at the specified position, and returns a reference to the spawned plane
//
//	local.spawnPosition is a reference to an info_waypoint (or similar object), with 
//	the filename of the model of the plane you want to spawn specified as $mymodel
//
//	If the supplied waypoint has a target, the plane will take it on as its target.
//
//	Accepts:
//		local.spawnPosition:	reference to an info_waypoint with $mymodel specified.	Required.	No default
//	
//	Returns:
//		a reference to the spawned plane
//----------------------------------------------------------------------------
	
	Assert (local.spawnPosition != NIL && "SpawnPlane requires a valid waypoint.")
	Assert (local.spawnPosition != NULL && "SpawnPlane was given a waypoint argument, but that argument didn't name a valid object in the map.")
	Assert (local.spawnPosition.mymodel != NIL && "SpawnPlaneVRP has been called on a spawnPosition that doesn't have its $mymodel key specified.")
	
	// Assigns local.spawnedPlane a class type and a model 
	local.spawnedPlane = spawn VehicleRidablePlane model local.spawnPosition.mymodel
	local.spawnedPlane waitthread ApplyPlaneVariables
	
	// Set the angle and the origin to the position passed
	local.spawnedPlane angles local.spawnPosition.angles
	local.spawnedPlane.origin = local.spawnPosition.origin
	
	// override this plane's health if we've been given a health value as an argument or on the spawner
	if (local.health != NIL && local.health > 0)
		local.spawnedPlane.health = local.health
	else if (local.spawnPosition.health != NIL && local.spawnPosition.health > 0)
		local.spawnedPlane.health = local.spawnPosition.health
	
	// if we've been provided a specific deathanim, apply it here
	if (local.deathanim != NIL)
		local.spawnedPlane.deathanim = local.deathanim	// long_crash, particle_death01, particle_death02, particle_death03
	
	if (local.spawnPosition.target != NIL)
	{
		//println "[PLANE_UTILS]: Target assigned to Plane"
		local.spawnedPlane.target = local.spawnPosition.target
	}
	
	if(local.stayInvulnerable == NIL)
		local.stayInvulnerable = 0
	
	local.spawnedPlane.stayInvulnerable = local.stayInvulnerable
	
	if(local.dontProtect != 1 )
		local.spawnedPlane thread ProtectPlane
	
end local.spawnedPlane


//----------------------------------------------------------------------------
ProtectPlane:
//
//	
//----------------------------------------------------------------------------
	
	self nodamage
	if(!self.stayInvulnerable)
	{
		wait 1
		if(isAlive self)
			self takedamage
	}
	
end


// SET COMMON PLANE PROPERTIES
//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

//----------------------------------------------------------------------------
ApplyPlaneVariables:
//
//	Reads the supplied plane's model filename, and calls the appropriate thread to set up its characteristics.
//	Must be run on an object with a recognized model filename.
//
//	Accepts:
//		Nothing
//	
//	Returns:
//		Nothing
//----------------------------------------------------------------------------	
	assert (self != NULL)
	
	self stop
	self runsounds 0
	
	// Init plane based on which model spawned
	switch ( self.model )
	{
	case "models/vehicles/sbddauntless.hag":
	
		self waitthread ApplySBDVariables
		break

	case "models/vehicles/sbddauntless_ground.hag":

		self waitthread ApplySBDGroundVariables
		break

	case "models/vehicles/wildcat.hag":
	
		self waitthread ApplyWildcatVariables
		break

	case "models/vehicles/wildcat_ground.hag":
	
		self waitthread ApplyWildcatGroundVariables
		break
		
	case "models/vehicles/P400.hag":
	
		self waitthread ApplyP400Variables
		break
		
	case "models/vehicles/P400_ground.hag":
		
		self waitthread ApplyP400Variables
		break
	
	case "models/vehicles/P40.hag":
	
		self waitthread ApplyP40Variables
		break
		
	case "models/vehicles/kingfisher.hag":
	
		self waitthread ApplyKingfisherVariables
		break
		
	case "models/vehicles/zero.hag":
	case "models/vehicles/zero_pearl.hag":
	case "models/vehicles/zero_pearl_nearplayer.hag":
	
		self waitthread ApplyZeroVariables
		break
		
	case "models/vehicles/val.hag":
	case "models/vehicles/val_pearl.hag":
	
		self waitthread ApplyValVariables
		break
		
	case "models/vehicles/kate.hag":
	
		self waitthread ApplyKateVariables
		break
		
	case "models/vehicles/mitsubishig4m3betty.hag":
	
		self waitthread ApplyBettyVariables
		break
	
	case "models/vehicles/blackcat/blackcat.gr2":
		
		self waitthread ApplyCatalinaVariables
		break
		
	default:
		dprintln "[PLANE_UTILS]: WARNING: ApplyPlaneVariables was run on a model it hasn't yet been set up to handle: " self.model
	}
	
end


//----------------------------------------------------------------------------
ApplySBDVariables:
//
//	Applies flight characteristics appropriate to an SBD
//	Usually called by ApplyPlaneVariables, but may be called directly if desired.
//
//	Accepts:
//		Nothing
//	
//	Returns:
//		Nothing
//----------------------------------------------------------------------------
	
	//self setmaxturnspeed 50 35 70 	// Float max_roll, Float max_yaw, Float max_pitch
	self maxrollrate 	50 
	self maxyawrate 	35
	self maxpitchrate 	70 	
	self setmaxrollangle	90
	
	self speed		4000	1
	
	self health		1000
	
	self.team = "ALLIES"
	self allies
	
	self.flybysound = Dauntless_By
	
end

//----------------------------------------------------------------------------
ApplySBDGroundVariables:
//
//	Applies flight characteristics appropriate to an SBD
//	Usually called by ApplyPlaneVariables, but may be called directly if desired.
//
//	Accepts:
//		Nothing
//	
//	Returns:
//		Nothing
//----------------------------------------------------------------------------
	
	
	self maxrollrate	0 
	self maxyawrate		35
	self maxpitchrate	0 
	self setmaxrollangle	0
	
	self taxiing		1 

	self health		1000
	
	// added to broadcast engine sounds to clients, who then 
	// know to have their renderer cull the model
	self svflags "+broadcast"
	
	self.team = "ALLIES"
	self allies
	
end

