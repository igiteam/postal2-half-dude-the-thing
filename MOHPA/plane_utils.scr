//----------------------------------------------------------------------------
DrawDebugLine:
//----------------------------------------------------------------------------
	level.DEBUGLINES[1] = NIL
	while( 1 )
	{
		if( level.DRAWMYDEBUGLINE == 1 )
		{
			for( local.i = 2; local.i <= level.DEBUGLINES.size; local.i++ )
			{
				local.vec1 = level.DEBUGLINES[local.i-1]
				local.vec2 = level.DEBUGLINES[local.i]
				debugline local.vec1 local.vec2 1.0 1.0 0.0 1.0
			}
			waitframe
		}
		else
		{
			wait 1
		}
	}
end



//----------------------------------------------------------------------------
FlySplinePathThread local.flyto local.speed local.acceleration local.lookahead local.invokefailsafe local.dobadplace:
//
//
//----------------------------------------------------------------------------

	if ( local.invokefailsafe==NIL )
		local.invokefailsafe	= 0

	if ( local.dobadplace==NIL )
		local.dobadplace		= 0

	// Move from parked position
	self flysplinepath local.flyto local.speed local.acceleration local.lookahead
	
	if ( local.invokefailsafe )
	{
		self thread FlySplinePathFailsafe local.speed
		local.failsafe = parm.previousthread
	}

	if ( local.dobadplace )
	{
		self thread DoBadPlace
	}

	self waittill movedone

	self thread EndBadPlace
	
	local.failsafe delete

end

//----------------------------------------------------------------------------
FlySplinePathFailsafe local.speed:
//
//
//----------------------------------------------------------------------------

//	local.endtime = level.inttime + 25000

	local.origin = self.origin
	local.angles = self.angles
	local.angle = local.angles[1]

	if ( self.isAlive==0 )
		println "Cannot do failsafe on dead plane."

//	while( level.inttime < local.endtime )
	while( self!=NULL )
	{
		wait 0.2	// wait long enough to allow plane to turn.

		if ( level.nofailsafes!=1 )
		{
			if ( vector_within self.origin local.origin 1.0 )
			{
				// make sure we're not turning
				local.angles = self.angles
				local.curr_angle = local.angles[1]

				local.diff = local.curr_angle - local.angle

				if ( local.diff < 1 && local.diff > -1 )
				{
					if ( self.isAlive )
					{
						println "Invoking stutter step for plane:" self.targetname " at location " self.origin
						self speed 1
						wait 3
						self speed local.speed
						// let it get up to speed...
						wait 2
					}
				}
				else
				{
					println "Plane is turning at: " self.origin " angle:" local.angle
				}
			}
		}

		local.origin = self.origin
		local.angles = self.angles
		local.angle = local.angles[1]
	}

//	println "Invoking failsafe for plane:" self.targetname

end

//----------------------------------------------------------------------------
DoBadPlace:
//----------------------------------------------------------------------------

	self.dobadplace = 1

	while ( self.dobadplace )
	{
		//level badplace self.targetname self.origin 300 both
		self waitthread DoPlaneBadPlace
		wait 0.5
	}

	end

//----------------------------------------------------------------------------
EndBadPlace:
//----------------------------------------------------------------------------

	self.dobadplace = 0

	end

//----------------------------------------------------------------------------
DoPlaneBadPlace:
//----------------------------------------------------------------------------

	if ( self.lastorigin!=NIL && self.lastorigin==self.origin )
		end

	if ( self.targetname=="" )
		self.targetname = "plane_" + self.entnum

	self.lastorigin = self.origin

	level badplace self.targetname self.origin 225 both


	local.forward	= angles_toforward self.angles
	local.backward	= vector_scale local.forward -300
	local.left		= angles_toleft self.angles
	local.right		= vector_scale local.left -300
	local.left		= vector_scale local.left 300

	local.tailpos	= vector_add self.origin local.backward
	local.leftwing	= vector_add self.origin local.left
	local.rightwing	= vector_add self.origin local.right

	local.name = self.targetname + "_back"
	level badplace local.name local.tailpos 150 both

	local.name = self.targetname + "_left"
	level badplace local.name local.leftwing 100 both

	local.name = self.targetname + "_right"
	level badplace local.name local.rightwing 100 both

	end

//----------------------------------------------------------------------------
RemovePlaneBadPlace:
//----------------------------------------------------------------------------


	local.tailname			= self.targetname + "_back"
	local.leftwingname		= self.targetname + "_left"
	local.rightwingname		= self.targetname + "_right"
	
	level removebadplace self.targetname
	level removebadplace local.tailname
	level removebadplace local.leftwingname
	level removebadplace local.rightwingname

	end
