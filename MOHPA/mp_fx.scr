//----------------------------------------------------------------------------
oneshotfx_nodelete local.fxModel local.broadcast:
//----------------------------------------------------------------------------

	local.my_obj = self waitthread wait_for_my_objective		

	if(local.broadcast == NIL || local.broadcast == NULL)
		local.broadcast = 0
		
	local.fx = spawn Animate model local.fxModel
	local.fx.origin = self.origin	
	if (self.scale != NIL && self.scale != NULL)
		local.fx scale self.scale
	
	if(local.broadcast)
		local.fx svflags "+broadcast"
		
	self remove

	if (level.gameType == 6 && local.my_obj != 4 && local.my_obj != 0)
	{
		level.startObjTrigger[local.my_obj+1] waittill trigger
		local.fx remove
	}
	
	//dprintln "onshotfx_nodelete done"
	
end

//----------------------------------------------------------------------------------
do_runway_lights local.tiki:
//----------------------------------------------------------------------------------

	local.my_obj = self waitthread wait_for_my_objective
	//dprintln "doing runway"

	while ((level.currentObjective == local.my_obj && level.dmNoeffects != 1) || local.my_obj == 0)
	{
		local.ent = self
		
		while (local.ent != NIL && local.ent != NULL)
		{
			local.ent thread blink_light local.tiki 1			
			local.ent = $(local.ent.target)
			wait 0.2
		}
		
		wait 3
	}

end

//----------------------------------------------------------------------------------
do_birds:
//----------------------------------------------------------------------------------
end
	wait 5 
	dprintln "doing birds"

	local.array = $(self.target)
	
	if (local.array.size < 1)
	{
		dprintln "invalid bird array in group # " self.group	
		end
	}

	self setthread start_flocking
	
	$(self.target) thread randomize_orient

/* Known events for fauna_bird	
Event EV_Bird_GroupLead		("group_lead"			, EV_DEFAULT, "i", "groupnbr"	,"Sets the bird as the leader of the flock.");
Event EV_Bird_GroupJoin		("group_join"			, EV_DEFAULT, "i", "groupnbr"	,"Joins a flock.");
Event EV_Bird_GroupLeave	("group_leave"			, EV_DEFAULT, "i", "groupnbr"	,"Leaves the flock.");
Event EV_Bird_GroupDisband	("group_disband"		, EV_DEFAULT, "I" ,"groupnbr"	,"Tell the group to disband.");
Event EV_Bird_GroupSpeed	("group_speed"			, EV_DEFAULT, "f"  ,"speed_mps"	,"Sets the speed of the flock in meters per second.");
Event EV_Bird_GroupHeight	("group_height"			, EV_DEFAULT, "f"  ,"height_m"	,"Sets the height of the flock in meters.");
Event EV_Bird_TurnInitSpeed	("turn_init_speed"		, EV_DEFAULT, "f"  ,"turninitf"	,"How fast the lead bird turns in degrees initially.");
Event EV_Bird_TurnFinalSpeed("turn_final_speed"		, EV_DEFAULT, "f"  ,"turnfinalf","How fast the lead bird turns in degrees initially.");
Event EV_Bird_TurnSpeed		("turn_speed"			, EV_DEFAULT, "f"  ,"turnspeedf","How fast the lead bird turns in degrees per second.");
Event EV_Bird_FollowRatio	("follow_ratio"			, EV_DEFAULT, "f"  ,"ratio"		,"Sets speed ratio of follow birds based on the leader speed.");
Event EV_Bird_GroupDest		("group_destination"	, EV_DEFAULT, "ie" ,"grpID,ent"	,"Tells the bats where to go during a disband operation.");
*/
	
end

//----------------------------------------------------------------------------------
randomize_orient:
//----------------------------------------------------------------------------------

	local.a = self.angles
	local.a[1] = randomint 360
	self.angles = local.a

end

//----------------------------------------------------------------------------------
start_flocking local.player:
//----------------------------------------------------------------------------------

	dprintln "starting to flock"

	self nottriggerable
	local.player playsound Birds_Flock_Large01
	self ai_event misc 2000
	
	$(self.target) thread bird_flock self.group self.dest
	
end

// Notes: This seems to cause a strange fatal assert in game. Contacted Chris about it
// Notes: Leaving out for now.
//----------------------------------------------------------------------------------
bird_flock local.group local.dest:
//----------------------------------------------------------------------------------
	
	wait (randomfloat 0.5)
	
	self show
	self notsolid
	self anim fly_flap
	
	self group_lead local.group	
	self group_speed (3.0 + (randomfloat 4.0))
	self group_height (5.0 + (randomfloat 5.0))
	self turn_init_speed (300.0 + (randomfloat 300.0))
	self turn_final_speed (15.0 + (randomfloat 10.0))
	self follow_ratio (0.5 + (randomfloat 0.5))
	if (local.dest != NIL && local.dest != NULL)
		self group_destination local.group local.dest

	wait (3.0 + (randomint 5.0))
	
	self group_disband
	
end

//----------------------------------------------------------------------------------
wait_for_my_objective:
//----------------------------------------------------------------------------------

	if (level.gameType != 6 && self.obj != 0)
		end 1

	// if the mapper has predetermined what objective this fx is active for
	// then let that be the default
	if (self.obj != NIL && self.obj != NULL)
	{
		if (self.obj == 0)
			end 0
		else{
			level.startObjTrigger[self.obj] waittill trigger	
			end self.obj
		}
	}

	// determine 'my' objective as the average origin i am closest too
	local.best_dist = 99999
	local.my_obj  = 0
	
	for (local.i=1; local.i<=4; local.i++)
	{
		local.dv = self.origin - level.aveObjPos[local.i]		
		local.dist = vector_length local.dv
		
		if (local.dist < local.best_dist)
		{
			local.best_dist = local.dist
			local.my_obj = local.i
		}
	}
	
	//dprintln "my obj = " local.my_obj	
	level.startObjTrigger[local.my_obj] waittill trigger	
	//dprintln "my objective " local.my_obj " started"

end local.my_obj

//-----------------------------------------------------------------------------
wait_to_kill_all_fx:
//-----------------------------------------------------------------------------
	
	level.dmNoeffects = 0
	wait 5
	
	//dprintln "waiting to kill all fx"
	
	while (1)
	{
		if (int (getcvar (dm_noeffects)) == 1)
		{
			//dprintln "killing all FX"
			
			level.dmNoeffects = 1
			
			trigger level.startObjTrigger[1]
			wait 0.1
			trigger level.startObjTrigger[2]
			wait 0.1
			trigger level.startObjTrigger[3]
			wait 0.1
			trigger level.startObjTrigger[4]
			
			setcvar "dm_noeffects" "0"
		}
		wait 1.0
	}
	
	//dprintln "wait to delete done"

end
