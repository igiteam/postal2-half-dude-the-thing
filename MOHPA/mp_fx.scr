//
// mp_fx.scr
//
// provides ambient effects for mohpa

// most fx are simply labled script origins

// only skeeters are triggers

level.aveObjPos[1] = (0 0 0)
level.aveObjPos[2] = (0 0 0)
level.aveObjPos[3] = (0 0 0)
level.aveObjPos[4] = (0 0 0)

level.gameType  = int( getcvar( g_gametype ) )

if ( int(getcvar (dm_noeffects))== 1 )
	end

if (level.gameType == 6)
{
	//dprintln "doing preprocess"

	// Pre-Proccessing step
	// determine the 'origin' of each objective as the average position of the spawn points for that objective
	// This is used to turn on fx only for the current objective and disable fx for completed objectives
	
	for (local.i=1; local.i<=4; local.i++)
	{
		local.total = 0

		// count up normal spawn points
		local.axis_spawn   = $("axis_spawn_" + local.i)
		local.allies_spawn = $("allies_spawn_" + local.i)
		
		for (local.j=1; local.j <= local.axis_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.axis_spawn[local.j].origin
			
		for (local.j=1; local.j <= local.allies_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.allies_spawn[local.j].origin
			
		local.total += local.axis_spawn.size
		local.total += local.allies_spawn.size
			
		// count big
		local.axis_spawn   = $("axis_spawn_" + local.i + "_big")
		local.allies_spawn = $("allies_spawn_" + local.i + "_big")
		
		for (local.j=1; local.j <= local.axis_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.axis_spawn[local.j].origin
			
		for (local.j=1; local.j <= local.allies_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.allies_spawn[local.j].origin

		local.total += local.axis_spawn.size
		local.total += local.allies_spawn.size

		// count small
		local.axis_spawn   = $("axis_spawn_" + local.i + "_small")
		local.allies_spawn = $("allies_spawn_" + local.i + "_small")
		
		for (local.j=1; local.j <= local.axis_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.axis_spawn[local.j].origin
			
		for (local.j=1; local.j <= local.allies_spawn.size; local.j++)
			level.aveObjPos[local.i] += local.allies_spawn[local.j].origin

		local.total += local.axis_spawn.size
		local.total += local.allies_spawn.size
			
		//dprintln "found a total of " local.total " obj " local.i " spawn points"
			
		level.aveObjPos[local.i] = vector_scale level.aveObjPos[local.i] (1.0 / (local.total))
	}
}
else
{
	//dprintln "skipping preproccess"
	level.currentObjective = 1
}

//dprintln "ave obj 1 = " level.aveObjPos[1]
//dprintln "ave obj 2 = " level.aveObjPos[2]
