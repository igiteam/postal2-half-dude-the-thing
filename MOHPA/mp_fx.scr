//		waitframe
////		if (local.sound != NIL && local.sound != NULL)
//			self playsound local.sound
				
		wait (self.minSpacing + (randomfloat (self.maxSpacing-self.minSpacing)))
		
		local.v = local.o - self.origin
		local.v = vector_normalize local.v
	
		for (local.i=1; local.i<local.num; local.i++)
		{
			local.l = self.minRange + (randomfloat (self.maxRange-self.minRange))
			
			local.o += (local.v * local.l)
			
			if (local.onGround)
			{
