//-----------------------------------------------------------------------------
spawn_explosion local.origin local.tiki local.scale local.sound:
//-----------------------------------------------------------------------------
	self playsound mp_arty_leadin
	wait 2
	thread spawn_fx local.origin local.tiki self.scale
	waitframe
	if (local.sound != NIL && local.sound != NULL)
		self playsound local.sound
end

//-----------------------------------------------------------------------------
do_mixed_explosions local.tiki local.tiki2 local.onGround local.randRadius local.sound:
//-----------------------------------------------------------------------------
	local.my_obj = self waitthread wait_for_my_objective
	
	// self is the script origin to spawn from
	// if the origin is targeting a trigger, then the trigger
	// will disable the fx (permanently) when hit
	
	if (self.radius != NIL && self.radius != NULL)
	{
		self.minRange = 0
		self.maxRange = self.radius/2
	}
	if (self.minRange == NIL || self.minRange == NULL)
		self.minRange = 0
	if (self.maxRange == NIL || self.maxRange == NULL || self.maxRange < self.minRange)
		self.maxRange = self.minRange + 250
		
	if (self.delay != NIL && self.delay != NULL)
	{
		self.minTime = self.delay
		self.maxTime = self.delay*2
	}
	if (self.minTime == NULL || self.minTime == NIL)
		self.minTime = 10	
	if (self.maxTime == NULL || self.maxTime == NIL || self.minTime > self.maxTime)
		self.maxTime = self.minTime + 10
	
	if (self.minVolley == NIL || self.minVolley == NULL)
		self.minVolley = 3
	if (self.maxVolley == NIL || self.maxVolley == NULL || self.maxVolley < self.minVolley)
		self.maxVolley = self.minVolley + 7
		
	if (self.spacing != NIL && self.spacing != NULL)
	{
		self.minSpacing = self.spacing
		self.maxSpacing = self.spacing + 0.5
	}
	if (self.minSpacing == NIL || self.minSpacing == NULL)
		self.minSpacing = 0.1	
	if (self.maxSpacing == NIL || self.maxSpacing == NULL || self.maxSpacing < self.minSpacing)
		self.maxSpacing = self.minSpacing + 0.5
		
	if (self.scale == NIL || self.scale == NULL)
		self.scale = 5
	
	
	while ((level.currentObjective == local.my_obj && level.dmNoeffects != 1) || local.my_obj == 0)
	{
		local.num = self.minVolley + (randomint (self.maxVolley-self.minVolley))
			
		//local.r = randomint 7
		//if (local.r == 0)
		
		// do first expl
		local.o = self.origin
		if (local.randRadius == 1)
		{		
			local.quadrant = randomint (4) + 1
		
			local.x = randomint(self.maxRange - self.minRange) + self.minRange
			local.y = randomint(self.maxRange - self.minRange) + self.minRange
		
			switch (local.quadrant)
			{
				case 1: 
					local.o[0] += local.x
					local.o[1] += local.y
					break	
				case 2: 
					local.o[0] -= local.x
					local.o[1] += local.y
					break
				case 3:
					local.o[0] -= local.x
					local.o[1] -= local.y
					break
				case 4: 
					local.o[0] += local.x
					local.o[1] -= local.y
					break	
			}
		}
		if (local.onGround)
		{
			local.o[2] = terrain_height 0 local.o[0] local.o[1]
		}
		
		local.exp_chooser = randomint 2
		if (local.exp_chooser==1)	
			self thread spawn_explosion local.o local.tiki self.scale local.sound
		else
			self thread spawn_explosion local.o local.tiki2 self.scale local.sound
		
		
//		waitframe
//		if (local.sound != NIL && local.sound != NULL)
//			self playsound local.sound
				
		wait (self.minSpacing + (randomfloat (self.maxSpacing-self.minSpacing)))
		
		local.v = local.o - self.origin
		local.v = vector_normalize local.v
	
		for (local.i=1; local.i<local.num; local.i++)
		{
			local.l = self.minRange + (randomfloat (self.maxRange-self.minRange))
			
			local.o += (local.v * local.l)
			
			if (local.onGround)
			{
				local.o[2] = terrain_height 0 local.o[0] local.o[1]
			}
			
			local.exp_chooser = randomint 2
			if (local.exp_chooser==1)	
				self thread spawn_explosion local.o local.tiki self.scale local.sound
			else
				self thread spawn_explosion local.o local.tiki2 self.scale local.sound
				
			wait (self.minSpacing + (randomfloat (self.maxSpacing-self.minSpacing)))
		}
		local.t = self.minTime + (randomint (self.maxTime-self.minTime))

		wait local.t
	}
	
	//dprintln "multi explosion thread done"
end

