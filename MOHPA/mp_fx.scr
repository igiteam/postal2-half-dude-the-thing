// PUBLIC ////////////////////////////////////////////////////////////////////////////

//----------------------------------------------------------------------------------
always_on_fx local.fx local.minWait local.maxWait:
//----------------------------------------------------------------------------------
	thread loopfx local.fx self.origin local.minWait local.maxWait self.scale
end

//----------------------------------------------------------------------------------
loopfx local.fxModel local.fxPos local.fxMinWait local.fxMaxWait local.scale:
//----------------------------------------------------------------------------------
	
	while(1) 
	{
		local.fx = spawn Animate model local.fxModel 
		local.fx svflags "+broadcast"	
		if (local.scale != NIL && local.scale != NULL)
			local.fx scale local.scale
		local.fx.origin = local.fxPos
		local.fx waittill animdone
		local.fx remove
		local.wait = randomfloat( local.fxMaxWait - local.fxMinWait ) + local.fxMinWait
		wait local.wait
	}

end

//-----------------------------------------------------------------------------
spawn_fx local.origin local.fx local.scale:
//-----------------------------------------------------------------------------

	local.temp = spawn Animate model local.fx 
	local.temp notsolid
	if (local.scale != NIL && local.scale != NULL)
		local.temp scale local.scale
	local.temp.origin = local.origin
	local.temp anim idle // CCARON - choose 'idle' cause this is almost always available
	local.temp waittill animdone // for some reason this fixes the respawning anim bug
	local.temp remove

end

//----------------------------------------------------------------------------------
blink_light local.tiki local.on_time:
//----------------------------------------------------------------------------------

	local.fx = spawn Animate model local.tiki
	local.fx.origin = self.origin
	local.fx anim idle
	wait local.on_time
	local.fx remove

end

// PRIVATE //////////////////////////////////////////////////////////////////////////

//-----------------------------------------------------------------------------
do_godray local.fx local.min local.max:
//-----------------------------------------------------------------------------


	local.my_obj = self waitthread wait_for_my_objective

	thread loopfx local.fx self.origin local.min local.max
	local.thread = parm.previousthread
	remove self

	if (level.gameType == 6 && local.my_obj != 4 && local.my_obj != 0)
	{
		level.startObjTrigger[local.my_obj+1] waittill trigger
		local.thread delete
		
		//dprintln "ending godray"
	}	

end


//-----------------------------------------------------------------------------
birds:
//-----------------------------------------------------------------------------


	// do ambient birds - activated by trigger and keeps
	// animtaing for 10 seconds.  If mapper tagets the trigger
	// to something, then the orject will be the origin of
	// the swarm, otherwise the origin is at the trigger center

	// self refers to the trigger multiple that calls has this as
	// a setthread

	if (self.swarm == NIL || self.swarm == NULL)
	{
		//dprintln "doing birds"
	
		self nottriggerable
		
		self.swarm = spawn Animate model "models/test/bird_scene.tik" targetname swarm
		self.swarm.origin = self.origin

		local.ent = $(self.target)

		if (local.ent != NIL && local.ent != NULL)
		{
			self.swarm.origin = local.ent.origin
			self.swarm2.origin = local.ent.origin
		}
		
		self.swarm anim swarm_on
		
		wait 10
		self.swarm remove
		self.swarm2 remove
		self.swarm = NULL
		
		self triggerable
	}

end


//-----------------------------------------------------------------------------
skeeters:
//-----------------------------------------------------------------------------


	// do ambient mosquitoes - activated by trigger and keeps
	// animtaing for 10 seconds.  If mapper tagets the trigger
	// to something, then the orbject will be the origin of
	// the swarm, otherwise the origin is at the trigger center

	// self refers to the trigger multiple that calls has this as
	// a setthread

	if (self.swarm == NIL || self.swarm == NULL)
	{
		//dprintln "doing skeeters"
	
		self nottriggerable
		
		self.swarm2 = spawn Animate model "models/fx/skeeters.tik" 
		self.swarm2.origin = self.origin
		self.swarm = spawn Animate model "models/fx/swarm_heavy.tik" targetname swarm
		self.swarm.origin = self.origin

		local.ent = $(self.target)

		if (local.ent != NIL && local.ent != NULL)
		{
			self.swarm.origin = local.ent.origin
			self.swarm2.origin = local.ent.origin
		}
		
		self.swarm anim swarm_on
		
		wait 10
		self.swarm remove
		self.swarm2 remove
		self.swarm = NULL
		
		self triggerable
	}

end


//-----------------------------------------------------------------------------
swarm:
//-----------------------------------------------------------------------------


	// do ambient fireflies - activated by trigger and keeps
	// animtaing for 10 seconds.  If mapper tagets the trigger
	// to something, then the orbject will be the origin of
	// the swarm, otherwise the origin is at the trigger center

	// self refers to the trigger multiple that calls has this as
	// a setthread

	if (self.swarm == NIL || self.swarm == NULL)
	{
		//dprintln "doing flies"
	
		self nottriggerable
		
		self.swarm = spawn Animate model self.tiki
		self.swarm.origin = self.origin
		
		local.ent = $(self.target)

		if (local.ent != NIL && local.ent != NULL)
		{
			self.swarm.origin = local.ent.origin
		}
			
		//dprintln "flies origin = " self.swarm.origin
		
		self.swarm anim start
		
		wait 10
		self.swarm remove
		self.swarm = NULL
		
		self triggerable
	}

end


//-----------------------------------------------------------------------------
do_oneshot local.tiki:
//-----------------------------------------------------------------------------


	local.my_obj = self waitthread wait_for_my_objective
	
	//dprintln "starting " local.tiki
	
	// self is a script_origin where the effect takes place
	thread global/vfx.scr::oneshotfx_nodelete local.tiki self.origin
	local.thread = parm.previousthread
	self remove
	
	if (level.gameType == 6 && local.my_obj != 4 && local.my_obj != 0)
	{
		level.startObjTrigger[local.my_obj+1] waittill trigger
		local.thread delete
		
		//dprintln "ending oneshot"
	}

end

//-----------------------------------------------------------------------------
do_loopfx local.tiki local.wait:
//-----------------------------------------------------------------------------


	local.my_obj = self waitthread wait_for_my_objective
	local.origin = self.origin
	local.scale = self.scale
	self remove	
	
	// self is a script_origin where the effect takes place

	while ((level.currentObjective == local.my_obj && level.dmNoeffects != 1) || local.my_obj==0)
	{
		thread spawn_fx local.origin local.tiki local.scale
		local.dt = local.wait - (local.wait/2)
		local.delay = randomfloat local.dt
		local.delay += (local.wait/2)
		wait local.delay
	}

end


//-----------------------------------------------------------------------------
do_tracer_fire local.tiki:
//-----------------------------------------------------------------------------

	local.my_obj = self waitthread wait_for_my_objective
	// self is the origin that defines to position of the tracer fire

	local.minBurst = 1.0
	local.maxBurst = 2.0
	local.xyAng    = 0
	local.zAng     = 0

	local.origin = self.origin
	self remove

	while ((level.currentObjective == local.my_obj && level.dmNoeffects != 1) || local.my_obj == 0)
	{
		local.firetime = local.minBurst + (randomfloat (local.maxBurst - local.minBurst))
		local.t = level.time
		local.endt = level.time + local.firetime
		
		local.fx = spawn Animate model local.tiki
		local.fx.origin = local.origin
		local.fx anim idle
		local.fx svflags "+nofarplane"
		
		local.angles = (0 0 0)
		local.angles[1] = randomfloat 0
		local.angles[0] = 0 + randomfloat 0
		local.dax = (randomfloat (local.xyAng * 2)) - local.xyAng
		local.daz = (randomfloat (local.zAng * 2)) - local.zAng

		while (level.time < local.endt)
		{
			local.dt = level.time - local.t
			
			local.angles[0] += (local.dax * local.dt)
			local.angles[1] += (local.daz * local.dt)
			local.fx.angles = local.angles
		
			waitframe
		}	
		
		local.fx remove
		local.delay = 2 + (randomfloat 0)
		wait local.delay
		
	}
	
	//dprintln "ending tracer fire"

end


//-----------------------------------------------------------------------------
setup_group_explosions local.tiki local.onGround local.randRadius local.sound local.explode:
//-----------------------------------------------------------------------------

	// this happens for every script origin named the targetname of self	

	// If explosions have been run on this set then my setup number will be set to 1.
	// If setup is not set to 1, then start up explosions on this particular script origin and mark every other script
	// origin with the same set number as being setup so that do_explosions is not run on them as well.
	if( self.setup != 1 )
	{
		self thread do_explosions local.tiki local.onGround local.randRadius local.sound local.explode 1
		self.setup = 1 		
		
		// now go through every script origin with the same set number and mark those as being setup
		for( local.i = 1; local.i <= $(self.targetname).size; local.i++ )				
		{
			if( $(self.targetname)[local.i].set == self.set )			
				$(self.targetname)[local.i].setup = 1				
			
		}				
	}
	
	// if you are already setup, then just sit tight and wait for the first script origin to use your origin
	// to fire off a special effect

end


//-----------------------------------------------------------------------------
do_explosions local.tiki local.onGround local.randRadius local.sound local.explode local.grouped:
//-----------------------------------------------------------------------------


	local.my_obj = self waitthread wait_for_my_objective
	
	if(local.explode == NIL || local.explode == NULL)
		local.explode = 0
	
	if(local.grouped == NIL || local.grouped == NULL)
		local.grouped = 0
	
	// self is the script origin to spawn from
	// if the origin is targeting a trigger, then the trigger
	// will disable the fx (permanently) when hit
	
	if (self.radius != NIL && self.radius != NULL){
		self.minRange = 0
		self.maxRange = self.radius/2
	}
	if (self.minRange == NIL || self.minRange == NULL)
		self.minRange = 0
	if (self.maxRange == NIL || self.maxRange == NULL || self.maxRange < self.minRange)
		self.maxRange = self.minRange + 250

	if (self.delay != NIL && self.delay != NULL)
	{
		self.minTime = self.delay
		self.maxTime = self.delay*2
	}
	if (self.minTime == NULL || self.minTime == NIL)
		self.minTime = 10	
	if (self.maxTime == NULL || self.maxTime == NIL || self.minTime > self.maxTime)
		self.maxTime = self.minTime + 10
	if (self.scale == NIL || self.scale == NULL)
		self.scale = 5
			
	while ((level.currentObjective == local.my_obj && level.dmNoeffects != 1) || local.my_obj == 0)
	{
		local.o = self.origin
		if (local.randRadius == 1)
		{		
			local.quadrant = randomint (4) + 1
		
			local.x = randomint(self.maxRange - self.minRange) + self.minRange
			local.y = randomint(self.maxRange - self.minRange) + self.minRange
		
			switch (local.quadrant)
			{
				case 1: 
					local.o[0] += local.x
					local.o[1] += local.y
					break	
				case 2: 
					local.o[0] -= local.x
					local.o[1] += local.y
					break
				case 3:
					local.o[0] -= local.x
					local.o[1] -= local.y
					break
				case 4: 
					local.o[0] += local.x
					local.o[1] -= local.y
					break	
			}
		}
		if (local.onGround)
		{
			local.o[2] = terrain_height 0 local.o[0] local.o[1]
		}		
		
		if(local.explode)			
			level earthquake 0.090 0.090 0 0 local.o 1024
						
		if(local.grouped)
		{			
			// have every effect with this set number go off			
			local.set = self.set						
			for( local.i = 1; local.i <= $(self.targetname).size; local.i++ )				
			{				
				if( $(self.targetname)[local.i].set == local.set )				
					thread spawn_fx $(self.targetname)[local.i].origin local.tiki $(self.targetname)[local.i].scale						
				
			}										
		}
		else
			thread spawn_fx local.o local.tiki self.scale
				
		waitframe
		if (local.sound != NIL && local.sound != NULL)
			self playsound local.sound

		local.t = self.minTime + (randomint (self.maxTime-self.minTime))

		wait local.t
	}
	
	self remove	
 
end

