// ------------------------------------------------------------------------
//	navterrain.scr
//
//	Handles terrain navigation... (ie: jumping over, climbing under, etc...)
// ------------------------------------------------------------------------


// ------------------------------------------------------------------------
main:
// ------------------------------------------------------------------------


end

// ------------------------------------------------------------------------
Init:
// ------------------------------------------------------------------------
	waitexec anim/default_inithandler.scr
	waitexec anim/smoking.scr::SmokeRemoveCigarette
	self weaponcommand mainhand attachtohand mainhand

	//make sure we are standing...
	waitexec anim/stand.scr::transition

end

// ------------------------------------------------------------------------
JumpDownSmall:
// ------------------------------------------------------------------------

	self waitthread Init

//	self setmotionanim xrsxx_navjumpdown_64
	if ( self.team!="american" )
	{
		// want fragile enemies when doing nav anims.
		self fragile 4
	}
	self setmotionanim (self getalias navjumpdown 64)
	self waittill flaggedanimdone

	end

