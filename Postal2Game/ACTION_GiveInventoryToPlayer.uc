///////////////////////////////////////////////////////////////////////////////
// ACTION_GiveInventoryToPlayer
// Gives the player a specified inventory item.
///////////////////////////////////////////////////////////////////////////////
class ACTION_GiveInventoryToPlayer extends P2ScriptedAction;

///////////////////////////////////////////////////////////////////////////////
// Public vars
///////////////////////////////////////////////////////////////////////////////
var(Action) class<Inventory> InvType;	// Class of Inventory to give

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
function bool InitActionFor(ScriptedController C)
{
	local P2Pawn P;
	local Inventory ThisInv;

	P = GetPlayerPawn(C);

	if (P != None && InvType != None)
	{
		ThisInv = P.CreateInventoryByClass(InvType);
		if (P2Weapon(ThisInv) != None
			&& P2AmmoInv(Weapon(ThisInv).AmmoType) != None
			&& !P2AmmoInv(Weapon(ThisInv).Ammotype).Default.bInfinite)
			P2AmmoInv(Weapon(ThisInv).AmmoType).bInfinite = false;
	}

	return false;
}

function string GetActionString()
	{
		return ActionString@InvType;
	}

///////////////////////////////////////////////////////////////////////////////
// Default properties
///////////////////////////////////////////////////////////////////////////////

// Decompiled with UE Explorer.
defaultproperties
{
    ActionString="Give inventory"
}