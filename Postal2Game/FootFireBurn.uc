///////////////////////////////////////////////////////////////////////////////
// FootFireBurn
// visual and burning
///////////////////////////////////////////////////////////////////////////////
class FootFireBurn extends P2Emitter;

var float BurnTime;
var float Dam;
var class<P2Damage> mydam;
var bool bDestroying;

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
function Touch(Actor Other)
{
	if(Other != Owner
		&& !bDestroying)
	{
		Other.TakeDamage(Dam, Pawn(Owner), Other.Location, vect(0,0,1), mydam);
	}
}

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
// Burning
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
auto state Burning
{
Begin:
	Sleep(BurnTime);
	bDestroying=true;
	SelfDestroy();
}


// Decompiled with UE Explorer.
defaultproperties
{
    BurnTime=10.0000000
    Dam=10.0000000
    mydam=Class'BaseFX.BurnedDamage'
    Emitters[0]=SuperSpriteEmitter'SuperSpriteEmitter32'
    AutoDestroy=true
    AmbientSound=Sound'WeaponSounds.fire_large'
    SoundRadius=40.0000000
    SoundVolume=255
    TransientSoundVolume=255.0000000
    TransientSoundRadius=40.0000000
    CollisionRadius=80.0000000
    CollisionHeight=60.0000000
    bCollideActors=true
}