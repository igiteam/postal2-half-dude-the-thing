///////////////////////////////////////////////////////////////////////////////
// ACTION_TakeInventory
// Removes inventory item if they have it.
///////////////////////////////////////////////////////////////////////////////
class ACTION_TakeInventory extends ScriptedAction;

///////////////////////////////////////////////////////////////////////////////
// Public vars
///////////////////////////////////////////////////////////////////////////////
var(Action) class<Inventory> InvType;

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
function bool InitActionFor(ScriptedController C)
{
	local FPSPawn P;
	local Inventory ThisInv;

	P = FPSPawn(C.Pawn);

	if (P != None && InvType != None)
	{
		for (ThisInv = P.Inventory; ThisInv != None; ThisInv = ThisInv.Inventory)
		{
			if (ThisInv.Class == InvType)
			{
				P.DeleteInventory(ThisInv);
				return true;
			}
		}
	}

	return false;
}

function string GetActionString()
	{
		return ActionString@InvType;
	}

///////////////////////////////////////////////////////////////////////////////
// Default properties
///////////////////////////////////////////////////////////////////////////////

// Decompiled with UE Explorer.
defaultproperties
{
    ActionString="Take inventory"
}