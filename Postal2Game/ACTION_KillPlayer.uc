///////////////////////////////////////////////////////////////////////////////
// ACTION_KillPlayer
// Kills player and destroys all inventory.
///////////////////////////////////////////////////////////////////////////////
class ACTION_KillPlayer extends P2ScriptedAction;

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
function bool InitActionFor(ScriptedController C)
{
	local P2Player P;

	P = P2GameInfo(C.Level.Game).GetPlayer();

	if (P != None)
	{
		P2Pawn(P.Pawn).DestroyAllInventory();
		P.Pawn.Died(None, class'DamageType', P.Pawn.Location);
	}

	return false;
}

///////////////////////////////////////////////////////////////////////////////
// Default properties
///////////////////////////////////////////////////////////////////////////////

// Decompiled with UE Explorer.
defaultproperties
{
    ActionString="Kill player"
}