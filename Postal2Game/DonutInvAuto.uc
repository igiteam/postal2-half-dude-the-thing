//
// Medical kit, gives you health back
//
// Doesn't use RateHealingPower with the QuickHealth becuase you don't have
// these in your inventory long enough to mess with them.
//
///////////////////////////////////////////////////////////////////////////////
class DonutInvAuto extends OwnedInv;

///////////////////////////////////////////////////////////////////////////////
// Give him health
///////////////////////////////////////////////////////////////////////////////
function Activate()
{
	local P2Pawn CheckPawn;

	CheckPawn = P2Pawn(Owner);
	CheckPawn.AddHealthPct(class'DonutInv'.default.HealingPct);
}

///////////////////////////////////////////////////////////////////////////////
// Default properties
///////////////////////////////////////////////////////////////////////////////


// Decompiled with UE Explorer.
defaultproperties
{
    bPaidFor=true
    bUseUpAutoActivate=true
    bAutoActivate=true
    InventoryGroup=124
    PickupClass=Class'DonutPickup'
}