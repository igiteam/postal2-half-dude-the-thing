///////////////////////////////////////////////////////////////////////////////
// ChemPillar
// 
// Pillar of chemical gas
//
///////////////////////////////////////////////////////////////////////////////
class ChemPillar extends P2Emitter;

var bool bStopped;

const MOVE_TIME	=	0.3;

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
// Active
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
auto state Active
{
	simulated function ProcessTouch(Actor Other, Vector HitLocation)
	{
		Stopping();
	}
	simulated function HitWall (vector HitNormal, actor Wall)
	{
		Stopping();
	}

	///////////////////////////////////////////////////////////////////////////////
	// Stop the pillar, but also make the top ball
	///////////////////////////////////////////////////////////////////////////////
	function Stopping()
	{
		local FireBall fp;
		if(!bStopped)
		{
			bStopped=true;
			Velocity.Z=0;
			// Top chemball
			spawn(class'ChemBall',,,Location);
		}
	}
Begin:
	Sleep(MOVE_TIME);
	Stopping();
}


// Decompiled with UE Explorer.
defaultproperties
{
    Emitters[0]=SuperSpriteEmitter'SuperSpriteEmitter212'
    Emitters[1]=SuperSpriteEmitter'SuperSpriteEmitter16'
    Emitters[2]=SuperSpriteEmitter'SuperSpriteEmitter15'
    AutoDestroy=true
    Physics=6
    Velocity=(X=0.0000000,Y=0.0000000,Z=1000.0000000)
    bCollideActors=true
    bCollideWorld=true
    bBounce=true
}