class HealthPack extends AdvancedHealthPack
placeable;



//===========================================================================
// Default Properties
//===========================================================================

// Decompiled with UE Explorer.
defaultproperties
{
    HealSound=Sound'DOTZXInterface.PickupHealth'
    StaticMesh=StaticMesh'DOTZSSpecial.Pickups.HealthPack'
}