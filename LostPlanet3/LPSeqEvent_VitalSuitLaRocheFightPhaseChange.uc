class LPSeqEvent_VitalSuitLaRocheFightPhaseChange extends SequenceEvent
    forcescriptorder(true)
    hidecategories(Object);

static event GetObjClassVersion()
{
    local /*0x97E50000-0x00000000*/ private int ReturnValue[92274689];

    return super(SequenceObject).GetObjClassVersion() + 1;
    //return ReturnValue;    
}

function HandleMessage()
{
    local /*0x97E50000-0x00000000*/ private @NULL InOriginator[8388609], InInstigator;
    local /*0x97E50000-0x00000000*/ private byte inLaRocheBossFightPhaseEvent[8388609];
    local /*0x97E50000-0x00000000*/ private int inPriority[8388609];
    local /*0x97E50000-0x00000000*/ private @NULL intVar;
    local /*0x97E50000-0x00000000*/ private editfixedsize array ActivateIndices;

    // End:0x2B
    if(int(inLaRocheBossFightPhaseEvent) >= int(0))
    {
        ActivateIndices[0] = int(inLaRocheBossFightPhaseEvent);
    }
    PublishLinkedVariableValues();
    // End:0x11D
    if(((InOriginator != none) && bEnabled) && !bPlayerOnly || (InInstigator != none) && InInstigator.IsPlayerOwned())
    {
        // End:0x11D
        if(CheckActivate(InOriginator, InInstigator, false, ActivateIndices))
        {
            // End:0x11C
            foreach LinkedVariables(Class'Engine.SeqVar_Int', intVar, "Dialog Priority")
            {
                intVar.IntValue = inPriority;                
            }            
        }
    }
    //return;    
}

