class LPSeqEvent_GeneralInteractionObjectEvent extends SequenceEvent
    forcescriptorder(true)
    hidecategories(Object);

enum EGeneralInteractionObjectEventLinks
{
    EGeneralInteractionObjectEventLink_Disabled,// 0
    EGeneralInteractionObjectEventLink_Enabled,// 1
    EGeneralInteractionObjectEventLink_Preparing,// 2
    EGeneralInteractionObjectEventLink_BeginOperating,// 3
    EGeneralInteractionObjectEventLink_Operating,// 4
    EGeneralInteractionObjectEventLink_Complete,// 5
    EGeneralInteractionObjectEventLink_Aborted,// 6
    EGeneralInteractionObjectEventLink_MAX// 7
};

var(0.25_Pct) /*0x97E50000-0x00000000*/ private float OperatingProgress;
var(0.25_Pct) /*0x97E50000-0x00000000*/ private @NULL InstigatorPC;

event Activated()
{
    local /*0x97E50000-0x00000000*/ private @NULL InteractObject, LPP;

    InteractObject = LPGeneralPlayerInteractionObject(Originator);
    // End:0x5A
    if(InteractObject != none)
    {
        OperatingProgress = InteractObject.GetCompletionRatio() * float(100);
    }
    LPP = LPBasePlayerPawn(Instigator);
    // End:0xB6
    if(LPP != none)
    {
        InstigatorPC = LPPlayerController(LPP.Controller);
    }
    //return;    
}

defaultproperties
{
    MaxTriggerCount=0
    bPlayerOnly=false
    OutputLinks[0]=(Links=none,LinkDesc="Disabled",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[1]=(Links=none,LinkDesc="Enabled",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[2]=(Links=none,LinkDesc="Preparing",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[3]=(Links=none,LinkDesc="Begin Operating",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[4]=(Links=none,LinkDesc="Operating",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[5]=(Links=none,LinkDesc="Complete Operating",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    OutputLinks[6]=(Links=none,LinkDesc="Abort Operating",bHasImpulse=false,bDisabled=false,bDisabledPIE=false,LinkedOp=none,ActivateDelay=0.0000000,DrawY=0,bHidden=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0,PIEActivationTime=0.0000000,bIsActivated=false)
    VariableLinks[0]=(ExpectedType=Class'Engine.SeqVar_Object',LinkedVariables=none,LinkDesc="Instigator (Player Pawn)",LinkVar="None",PropertyName="Instigator",bWriteable=false,bSequenceNeverReadsOnlyWritesToThisVar=false,bModifiesLinkedObject=false,bHidden=false,MinVars=1,MaxVars=255,DrawX=0,CachedProperty=none,bAllowAnyType=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0)
    VariableLinks[1]=(ExpectedType=Class'Engine.SeqVar_Object',LinkedVariables=none,LinkDesc="Instigator (Player Controller)",LinkVar="None",PropertyName="InstigatorPC",bWriteable=false,bSequenceNeverReadsOnlyWritesToThisVar=false,bModifiesLinkedObject=false,bHidden=false,MinVars=1,MaxVars=255,DrawX=0,CachedProperty=none,bAllowAnyType=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0)
