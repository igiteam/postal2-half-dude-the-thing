    VariableLinks[3]=(ExpectedType=Class'Engine.SeqVar_Float',LinkedVariables=none,LinkDesc="Operating Progress",LinkVar="None",PropertyName="OperatingProgress",bWriteable=false,bSequenceNeverReadsOnlyWritesToThisVar=false,bModifiesLinkedObject=false,bHidden=false,MinVars=0,MaxVars=255,DrawX=0,CachedProperty=none,bAllowAnyType=false,bMoving=false,bClampedMax=false,bClampedMin=false,OverrideDelta=0)
