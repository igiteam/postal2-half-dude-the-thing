class LPSM_PlayerSwitchWeapon extends SPSpecialMove
    config(Game);

function SpecialMoveStarted()
{
    local /*0x97E50000-0x00000000*/ private bool bForced[8388609];
    local /*0x97E50000-0x00000000*/ private @NULL PrevMove[8388609], LPPC;

    super.SpecialMoveStarted(bForced, PrevMove);
    // End:0x9E
    if(MySPPawn.IsLocallyControlled())
    {
        LPPC = LPPlayerController(MySPPawn.Controller);
        // End:0x9E
        if(LPPC != none)
        {
            LPPC.NextWeapon();
        }
    }
    //return;    
}

function ProcessSMMessage()
{
    local /*0x97E50000-0x00000000*/ private name MessageName[8388609];
    local /*0x97E50000-0x00000000*/ private @NULL Sender[8388609];
    local /*0x97E50000-0x00000000*/ private int Data[8388609];
    local /*0x97E50000-0x00000000*/ private bool ReturnValue[92274689];

    switch(MessageName)
    {
        // End:0x57
        case Class'LPSMMTypes'.default.SMM_NotifyWeaponTakeOutFinished:
            MySPPawn.EndCurrentSpecialMove(self);
            // End:0x5A
            break;
        // End:0xFFFF
        default:
            break;
    }
    return super.ProcessSMMessage(MessageName, Sender, Data);
    //return ReturnValue;    
}

function SpecialMoveEnded()
{
    local /*0x97E50000-0x00000000*/ private @NULL PrevMove[8388609], NextMove;

    super.SpecialMoveEnded(PrevMove, NextMove);
    //return;    
}
