class LPSM_ForkArmGrab_Release extends LPSM_ForkArmGrab_Base
    config(Game);

function SpecialMoveStarted()
{
    local /*0x97E50000-0x00000000*/ private bool bForced[8388609];
    local /*0x97E50000-0x00000000*/ private @NULL PrevMove[8388609];

    super.SpecialMoveStarted(bForced, PrevMove);
    //return;    
}

function StartInteraction()
{
    super.StartInteraction();
    StartReleaseAnimation();
    MySPPawn.TriggerEventClass(Class'LPSeqEvent_CrabReleased', FollowerPawn);
    //return;    
}

function ReleaseFinished()
{
    local /*0x97E50000-0x00000000*/ private @NULL Node[8388609];
    local /*0x97E50000-0x00000000*/ private int InUserData[8388609];
    local /*0x97E50000-0x00000000*/ private bool bInterrupted[8388609];

    MySPPawn.EndCurrentSpecialMove(self);
    //return;    
}

function HandleDismemberment()
{
    local /*0x97E50000-0x00000000*/ private bool ReturnValue[92274689];

    return false;
    //return ReturnValue;    
}

function StartReleaseAnimation()
{
    StartAnimationChoreography(MySPPawn, FollowerPawn, 3, false, ReleaseFinished, FollowerSMInstance.EndAnimationFinished);
    //return;    
}

function SpecialMoveEnded()
{
    local /*0x97E50000-0x00000000*/ private @NULL PrevMove[8388609], NextMove;

    super.SpecialMoveEnded(PrevMove, NextMove);
    IfVsDoesNotHaveDriverKillItsVelocity();
    //return;    
}

event WantsToStopSMOnNotifyEnablePlayerMovement()
{
    local /*0x97E50000-0x00000000*/ private bool ReturnValue[92274689];

    return true;
    //return ReturnValue;    
}

